{
  "name": "@boltget/web",
  "private": true,
  "version": "0.0.0",
  "description": "boltget.app: the BoltGet website and user docs (Astro, Svelte islands, Starlight).",
  "license": "GPL-3.0-or-later",
  "type": "module",
  "scripts": {
    "brand": "node scripts/copy-brand.mjs",
    "dev": "node scripts/copy-brand.mjs && astro dev",
    "build": "node scripts/copy-brand.mjs && astro build",
    "preview": "astro preview",
    "check": "astro check && svelte-check --tsconfig ./tsconfig.json --fail-on-warnings",
    "deploy": "wrangler deploy"
  },
  "dependencies": {
    "@astrojs/sitemap": "3.7.4",
    "@astrojs/starlight": "0.42.7",
    "@astrojs/svelte": "9.1.1",
    "astro": "7.4.2",
    "smol-toml": "1.9.1",
    "svelte": "5.57.2"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.12",
    "svelte-check": "4.7.7",
    "typescript": "6.0.3",
    "wrangler": "^4.156.0"
  }
}
