---
// Shell for every marketing page: metadata, header, footer.
import "../styles/global.css";
import geistSemiBold from "../../../../brand/fonts/Geist-SemiBold.woff2?url";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import { t } from "../i18n";

interface Props {
  title: string;
  description: string;
  /** Use the title as is, without the " | BoltGet" suffix. */
  bareTitle?: boolean;
  /** "field": the header sits on the Home hero's atmosphere instead of paper. */
  header?: "paper" | "field";
}

const { title, description, bareTitle = false, header = "paper" } = Astro.props;
const site = t("site.name");
const fullTitle = bareTitle ? title : `${title} | ${site}`;
const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL("/og-image.png", Astro.site);
---

<!doctype html>
<html lang="en" dir="ltr" data-theme="light">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta name="theme-color" content={header === "field" ? "#031E18" : "#FFFFFF"} />
    <meta name="color-scheme" content="light" />
    <link rel="preload" href={geistSemiBold} as="font" type="font/woff2" crossorigin />
    <link rel="icon" href="/favicon.ico" sizes="48x48" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <slot name="head" />
    <script is:inline>
      // Review aid: ?at=<seconds> freezes the demos and skips entrance motion.
      if (new URLSearchParams(location.search).has("at")) document.documentElement.classList.add("frozen");
    </script>
  </head>
  <body>
    <a class="skip" href="#main">{t("site.skip")}</a>
    <Header variant={header} />
    <main id="main" tabindex="-1">
      <slot />
    </main>
    <Footer />
  </body>
</html>

<style>
  .skip {
    position: absolute;
    left: var(--gutter);
    top: -10rem;
    z-index: 10;
    padding: 0.625rem 1rem;
    background: var(--accent);
    color: var(--on-accent);
    font-weight: 600;
    text-decoration: none;
  }
  .skip:focus {
    top: 0.75rem;
  }
  main:focus {
    outline: none;
  }
  :global(.frozen *),
  :global(.frozen *::before),
  :global(.frozen *::after) {
    animation-delay: -60s !important;
    animation-play-state: paused !important;
    transition: none !important;
  }
</style>
