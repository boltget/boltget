---
// Shell for every marketing page: metadata, then the frame (docs/WEBSITE.md,
// Character): a white body with the header row on it, then the whole page in
// one rounded panel with the footer at its foot.
import "../styles/global.css";
import textFont from "../../../../brand/fonts/RedHatText-latin.woff2?url";
import displayFont from "../../../../brand/fonts/RedHatDisplay-latin.woff2?url";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import { t } from "../i18n";

interface Props {
  title: string;
  description: string;
  /** Use the title as is, without the " | Boltget" suffix. */
  bareTitle?: boolean;
}

const { title, description, bareTitle = false } = Astro.props;
const site = t("site.name");
const fullTitle = bareTitle ? title : `${title} | ${site}`;
const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL("/og-image.png", Astro.site);
---

<!doctype html>
<html lang="en" dir="ltr" data-theme="light">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta name="theme-color" content="#FFFFFF" />
    <meta name="color-scheme" content="light" />
    <link rel="preload" href={displayFont} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={textFont} as="font" type="font/woff2" crossorigin />
    <slot name="preload" />
    <link rel="icon" href="/favicon.ico" sizes="48x48" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <slot name="head" />
    <script is:inline>
      // Review aid: ?at=<seconds> freezes the demos and skips entrance motion.
      if (new URLSearchParams(location.search).has("at")) document.documentElement.classList.add("frozen");
    </script>
  </head>
  <body>
    <a class="skip" href="#main">{t("site.skip")}</a>
    <Header />
    <div class="frame">
      <main id="main" tabindex="-1">
        <slot />
      </main>
      <Footer />
    </div>
    <script>
      import { smoothDetails } from "../lib/disclosure";
      import { smoothScroll } from "../lib/smooth";
      smoothDetails();
      smoothScroll();
    </script>
  </body>
</html>

<style>
  .frame {
    position: relative;
    margin: 0 var(--frame-gap) var(--frame-gap);
    min-height: calc(100svh - var(--header-h) - 2 * var(--header-top) - var(--frame-gap));
    display: flex;
    flex-direction: column;
    border-radius: var(--frame-radius);
    background: var(--frame);
    box-shadow: var(--hairline-shadow);
  }
  main {
    flex: 1;
  }
  .skip {
    position: absolute;
    left: calc(var(--frame-gap) + 1rem);
    top: -10rem;
    z-index: 20;
    padding: 0.625rem 1rem;
    border-radius: 999px;
    background: var(--ink);
    color: var(--white);
    font-weight: 500;
    text-decoration: none;
  }
  .skip:focus {
    top: calc(var(--frame-gap) + 0.75rem);
  }
  main:focus {
    outline: none;
  }
  @media (max-width: 40rem) {
    .frame {
      --frame-radius: 20px;
    }
  }
  :global(.frozen *),
  :global(.frozen *::before),
  :global(.frozen *::after) {
    animation-delay: -60s !important;
    animation-play-state: paused !important;
    transition: none !important;
  }
</style>
