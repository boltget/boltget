---
// "Available on": the platform logos under a download button (docs/WEBSITE.md,
// Home as built). The logos keep their own colours, the one exception to the
// site's monochrome rule. Windows in full colour (a link to /download, or plain
// where the page is the download page); macOS and Linux grey and faded at rest,
// focusable, regaining some colour with a CSS-only "Coming soon" tooltip on
// hover and focus.
import PlatformLogo from "./PlatformLogo.astro";
import { t } from "../i18n";

interface Props {
  /** Where Windows links to; omit to show it without a link. */
  windowsHref?: string;
  class?: string;
}
const { windowsHref, class: className } = Astro.props;
---

<p class:list={["platform-row", className]}>
  <span class="lead">{t("platforms.lead")}</span>
  {
    windowsHref ? (
      <a class="os" href={windowsHref} aria-label={t("platforms.windowsLink")}>
        <PlatformLogo name="windows" size={15} />
      </a>
    ) : (
      <span class="os" role="img" aria-label={t("platforms.windows")}>
        <PlatformLogo name="windows" size={15} />
      </span>
    )
  }
  <span class="os off" tabindex="0" role="img" aria-disabled="true" aria-label={t("platforms.macosSoon")} data-tip={t("platforms.soon")}><PlatformLogo name="apple" size={18} /></span>
  <span class="os off" tabindex="0" role="img" aria-disabled="true" aria-label={t("platforms.linuxSoon")} data-tip={t("platforms.soon")}><PlatformLogo name="linux" size={19} /></span>
</p>

<style>
  .platform-row {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.35rem;
    font-size: 0.75rem;
    color: var(--graphite-600);
  }
  .lead {
    margin-right: 0.2rem;
  }
  .os {
    position: relative;
    display: inline-grid;
    place-items: center;
    width: 1.875rem;
    height: 1.875rem;
    border-radius: 8px;
    transition: background-color 0.16s linear;
  }
  .os :global(svg) {
    transition:
      filter 0.16s linear,
      opacity 0.16s linear;
  }
  a.os:hover {
    background: rgb(255 255 255 / 0.7);
  }
  .off {
    cursor: default;
  }
  /* Not yet available: grey and faded, so it never reads as a link. */
  .off :global(svg) {
    filter: grayscale(1);
    opacity: 0.45;
  }
  .off:hover :global(svg),
  .off:focus-visible :global(svg) {
    filter: grayscale(0.35);
    opacity: 0.85;
  }
  .off::after {
    content: attr(data-tip);
    position: absolute;
    bottom: calc(100% + 0.4rem);
    left: 50%;
    padding: 0.25rem 0.5rem;
    border-radius: 6px;
    background: var(--ink);
    color: var(--white);
    font-size: 0.6875rem;
    font-weight: 500;
    line-height: 1.2;
    white-space: nowrap;
    pointer-events: none;
    opacity: 0;
    transform: translate(-50%, 3px);
    transition:
      opacity 0.14s linear,
      transform 0.14s var(--ease-out);
  }
  .off:hover::after,
  .off:focus-visible::after {
    opacity: 1;
    transform: translate(-50%, 0);
  }
  @media (prefers-reduced-motion: reduce) {
    .off::after {
      transition: none;
      transform: translate(-50%, 0);
    }
  }
</style>
