---
// Site header. On paper it is sticky and translucent; on the Home hero
// ("field") it sits on the atmosphere in white. Three links; the source code
// is linked from the footer only (docs/WEBSITE.md, Home page).
import onDark from "../../../../brand/svg/lockup-horizontal-on-dark.svg";
import onLight from "../../../../brand/svg/lockup-horizontal-on-light.svg";
import { t } from "../i18n";

interface Props {
  variant?: "paper" | "field";
}
const { variant = "paper" } = Astro.props;
const lockup = variant === "field" ? onDark : onLight;
const path = Astro.url.pathname.replace(/\/$/, "") || "/";
const links = [
  { href: "/benchmarks/", label: t("nav.benchmarks"), match: "/benchmarks" },
  { href: "/docs/", label: t("nav.docs"), match: "/docs" },
  { href: "/changelog/", label: t("nav.changelog"), match: "/changelog" },
];
const height = 24;
const width = Math.round((lockup.width / lockup.height) * height);
---

<header class:list={["header", variant]}>
  <div class="wrap bar">
    <a class="brand" href="/" aria-label={t("nav.home")}>
      <img src={lockup.src} width={width} height={height} alt="" />
    </a>
    <nav aria-label={t("nav.label")}>
      <ul>
        {
          links.map((link) => (
            <li>
              <a href={link.href} aria-current={path.startsWith(link.match) ? "page" : undefined}>
                {link.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
  </div>
</header>

<style>
  .header {
    z-index: 5;
    height: var(--header-h);
  }
  .paper {
    position: sticky;
    top: 0;
    background: color-mix(in srgb, #fff 84%, transparent);
    backdrop-filter: blur(14px) saturate(1.4);
    -webkit-backdrop-filter: blur(14px) saturate(1.4);
    border-bottom: 1px solid color-mix(in srgb, var(--hairline) 80%, transparent);
  }
  .field {
    position: absolute;
    inset: 0 0 auto;
  }
  .bar {
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
  }
  .brand {
    flex: none;
    display: block;
    padding-block: 0.5rem;
  }
  ul {
    display: flex;
    gap: clamp(1.25rem, 2.6vw, 2.25rem);
    margin: 0;
    padding: 0;
    list-style: none;
  }
  nav a {
    display: block;
    padding-block: 0.5rem;
    font-size: 0.875rem;
    color: var(--text-muted);
    text-decoration: none;
    transition: color 0.2s;
  }
  nav a:hover,
  nav a[aria-current="page"] {
    color: var(--ink);
  }
  .field nav a {
    color: rgb(255 255 255 / 0.8);
  }
  .field nav a:hover {
    color: #fff;
  }
  .field :focus-visible {
    outline-color: #fff;
  }
  @media (max-width: 26rem) {
    .brand img {
      width: auto;
      height: 21px;
    }
    ul {
      gap: 1rem;
    }
  }
</style>
