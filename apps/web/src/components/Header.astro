---
// Site header (docs/WEBSITE.md, Character): a quiet row on the white page
// above the frame, as wide as the frame. Once the page scrolls it becomes a
// compact floating white bar, sticky at the top. Logo left; plain text links,
// GitHub and the black Download pill right. It keeps its place across page
// loads through a named view transition.
import lockup from "../../../../brand/svg/lockup-header-on-light.svg";
import lockup2x from "../../../../brand/svg/lockup-header-on-light@2x.svg";
import Icon from "./Icon.astro";
import { t } from "../i18n";

const path = Astro.url.pathname.replace(/\/$/, "") || "/";
const links = [
  { href: "/benchmarks/", label: t("nav.benchmarks"), match: "/benchmarks", wide: true },
  { href: "/docs/", label: t("nav.docs"), match: "/docs", wide: false },
  { href: "/changelog/", label: t("nav.changelog"), match: "/changelog", wide: true },
];
// The header lockup is drawn for its own size (28 px, the arrow on a 3 px
// pitch): gapless at 1x, 1-device-pixel gaps at 2x.
const { width, height } = lockup;
---

<header class="header" data-header>
  <div class="bar">
    <a class="brand" href="/" aria-label={t("nav.home")}>
      <img src={lockup.src} srcset={`${lockup.src} 1x, ${lockup2x.src} 2x`} width={width} height={height} alt="" />
    </a>
    <nav aria-label={t("nav.label")} data-nav>
      <ul>
        <li class="glide" aria-hidden="true" role="presentation" data-glide></li>
        {
          links.map((link) => (
            <li class:list={{ wide: link.wide }}>
              <a class="link" href={link.href} aria-current={path.startsWith(link.match) ? "page" : undefined}>
                {link.label}
              </a>
            </li>
          ))
        }
        <li>
          <a class="link github" href={t("site.repo")} aria-label={t("nav.github")}>
            <Icon name="github" size={16} />
            <span class="github-label">{t("nav.github")}</span>
          </a>
        </li>
        <li>
          <a class="cta button button-primary button-sm" href="/download/" aria-current={path.startsWith("/download") ? "page" : undefined}>
            {t("nav.download")}
          </a>
        </li>
      </ul>
    </nav>
  </div>
</header>

<style>
  .header {
    position: sticky;
    top: 0;
    z-index: 10;
    padding: var(--header-top) var(--frame-gap);
    view-transition-name: site-header;
    pointer-events: none;
  }
  .bar {
    max-width: 100%;
    height: var(--header-h);
    margin-inline: auto;
    padding-inline: 0.5rem 0;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    border-radius: 18px;
    background: rgb(255 255 255 / 0);
    box-shadow: 0 0 0 1px rgb(10 10 11 / 0);
    pointer-events: auto;
    transition:
      max-width 0.45s var(--ease-out),
      padding 0.45s var(--ease-out),
      background-color 0.3s linear,
      box-shadow 0.3s linear;
  }
  /* Scrolled (set by the script below): the compact floating bar. */
  .scrolled .bar {
    max-width: 60rem;
    padding-inline: 1.125rem 0.5rem;
    background: rgb(255 255 255 / 0.97);
    -webkit-backdrop-filter: blur(24px) saturate(1.4);
    backdrop-filter: blur(24px) saturate(1.4);
    box-shadow:
      0 0 0 1px rgb(10 10 11 / 0.06),
      0 1px 2px rgb(10 10 11 / 0.04),
      0 12px 32px -14px rgb(10 10 11 / 0.18);
  }
  .brand {
    flex: none;
    display: block;
    padding-block: 0.5rem;
    border-radius: 6px;
    view-transition-name: site-logo;
  }
  ul {
    position: relative;
    display: flex;
    align-items: center;
    gap: 0.25rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  /* The sliding highlight: one pill that glides between the links under the
     pointer or keyboard focus and rests under the current page's link (set
     up by the script below; without it each link has its own hover fill). */
  .glide {
    position: absolute;
    left: 0;
    top: 50%;
    z-index: -1;
    width: var(--gw, 0px);
    height: 2.25rem;
    margin-top: -1.125rem;
    border-radius: 10px;
    background: rgb(10 10 11 / 0.05);
    opacity: 0;
    pointer-events: none;
    transform: translateX(var(--gx, 0px));
  }
  .glide.on {
    opacity: 1;
  }
  .glide.moving {
    transition:
      transform 0.22s var(--ease-out),
      width 0.22s var(--ease-out),
      opacity 0.18s var(--ease-out);
  }
  .glide.fading {
    transition: opacity 0.18s var(--ease-out);
  }
  nav {
    isolation: isolate;
  }
  :global(.glides) .link:hover,
  :global(.glides) .link[aria-current="page"] {
    background: transparent;
  }
  .link {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    padding: 0.5rem 0.75rem;
    border-radius: 10px;
    font-size: 0.875rem;
    font-weight: 500;
    color: var(--text-muted);
    text-decoration: none;
    transition:
      color 0.2s,
      background-color 0.2s;
  }
  .link:hover,
  .link[aria-current="page"] {
    color: var(--ink);
    background: rgb(10 10 11 / 0.04);
  }
  .cta {
    margin-left: 0.375rem;
  }
  @media (max-width: 46rem) {
    .wide {
      display: none;
    }
  }
  @media (max-width: 26rem) {
    .scrolled .bar {
      padding-left: 0.875rem;
    }
    .github-label {
      display: none;
    }
    .link {
      padding-inline: 0.6rem;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .bar {
      transition: none;
    }
  }
</style>

<script is:inline>
  // The floating bar appears once the page has scrolled a little.
  (() => {
    const header = document.querySelector("[data-header]");
    if (!header) return;
    const update = () => header.classList.toggle("scrolled", window.scrollY > 12);
    window.addEventListener("scroll", update, { passive: true });
    update();
  })();

  // The nav's sliding highlight (see .glide above).
  (() => {
    const nav = document.querySelector("[data-nav]");
    const pill = nav && nav.querySelector("[data-glide]");
    if (!nav || !pill) return;
    const links = [...nav.querySelectorAll(".link")];
    const still = matchMedia("(prefers-reduced-motion: reduce)").matches;
    const current = links.find((l) => l.getAttribute("aria-current") === "page");
    let at = null;
    const place = (el) => {
      pill.style.setProperty("--gx", el.offsetLeft + "px");
      pill.style.setProperty("--gw", el.offsetWidth + "px");
    };
    const show = (el) => {
      if (!el || el.offsetParent === null) return hide();
      // From nothing it appears in place; between links it glides.
      pill.classList.toggle("moving", !still && at !== null);
      pill.classList.remove("fading");
      place(el);
      pill.classList.add("on");
      at = el;
    };
    const hide = () => {
      pill.classList.remove("moving");
      pill.classList.add("fading");
      pill.classList.remove("on");
      at = null;
    };
    const rest = () => (current ? show(current) : hide());
    nav.classList.add("glides");
    for (const l of links) {
      l.addEventListener("pointerenter", () => show(l));
      l.addEventListener("focus", () => show(l));
    }
    nav.addEventListener("pointerleave", rest);
    nav.addEventListener("focusout", (e) => {
      if (!nav.contains(e.relatedTarget)) rest();
    });
    new ResizeObserver(() => at && place(at)).observe(nav);
    rest();
  })();
</script>
