---
// Platform logos for the "Available on" row (PlatformRow.astro), in their own
// colours: a deliberate exception to the site's monochrome rule (docs/WEBSITE.md,
// Color). Windows is the Windows 11 four-pane logo in Microsoft blue; Apple has
// no brand colour, so its logo (path after Simple Icons, CC0) is graphite to
// ink; Tux is drawn for this site in its usual colours (black body, white
// belly, yellow-orange beak and feet), simplified to read at 16 to 18 px.
// Always decorative: the element around it carries the label.
interface Props {
  name: "windows" | "apple" | "linux";
  size?: number;
}

const { name, size = 18 } = Astro.props;
// Gradient ids must be unique on the page; a build-time counter keeps them stable.
const g = globalThis as { __platformLogo?: number };
g.__platformLogo = (g.__platformLogo ?? 0) + 1;
const id = `pl${g.__platformLogo}`;
---

{
  name === "windows" && (
    <svg width={size} height={size} viewBox="0 0 24 24" aria-hidden="true" focusable="false">
      <defs>
        <linearGradient id={`${id}w`} x1="2" y1="2" x2="22" y2="22" gradientUnits="userSpaceOnUse">
          <stop offset="0" stop-color="#2DA6F5" />
          <stop offset="1" stop-color="#0078D4" />
        </linearGradient>
      </defs>
      <path fill={`url(#${id}w)`} d="M2 2h9.4v9.4H2zM12.6 2H22v9.4h-9.4zM2 12.6h9.4V22H2zM12.6 12.6H22V22h-9.4z" />
    </svg>
  )
}
{
  name === "apple" && (
    <svg width={size} height={size} viewBox="0 0 24 24" aria-hidden="true" focusable="false">
      <defs>
        <linearGradient id={`${id}a`} x1="12" y1="0" x2="12" y2="24" gradientUnits="userSpaceOnUse">
          <stop offset="0" stop-color="#5F6267" />
          <stop offset="1" stop-color="#0A0A0B" />
        </linearGradient>
      </defs>
      <path
        fill={`url(#${id}a)`}
        d="M12.152 6.896c-.948 0-2.415-1.078-3.96-1.04-2.04.027-3.91 1.183-4.961 3.014-2.117 3.675-.546 9.103 1.519 12.09 1.013 1.454 2.208 3.09 3.792 3.039 1.52-.065 2.09-.987 3.935-.987 1.831 0 2.35.987 3.96.948 1.637-.026 2.676-1.48 3.676-2.948 1.156-1.688 1.636-3.325 1.662-3.415-.039-.013-3.182-1.221-3.22-4.857-.026-3.04 2.48-4.494 2.597-4.559-1.429-2.09-3.623-2.324-4.39-2.376-2-.156-3.675 1.09-4.61 1.09zM15.53 3.83c.843-1.012 1.4-2.427 1.245-3.83-1.207.052-2.662.805-3.532 1.818-.78.896-1.454 2.338-1.273 3.714 1.338.104 2.715-.688 3.559-1.701"
      />
    </svg>
  )
}
{
  name === "linux" && (
    <svg width={size} height={size} viewBox="0 0 24 24" aria-hidden="true" focusable="false">
      <defs>
        <linearGradient id={`${id}t`} x1="0" y1="7" x2="0" y2="23" gradientUnits="userSpaceOnUse">
          <stop offset="0" stop-color="#FFCB2E" />
          <stop offset="1" stop-color="#F08C00" />
        </linearGradient>
      </defs>
      {/* Body and head. */}
      <path
        fill="#141516"
        d="M12 1.2c-2.7 0-4.2 2.1-4.2 4.8 0 1.4.2 2.2-.8 3.6C5.5 11.6 4.2 13.6 4.2 16.3c0 1.6.5 2.9 1.4 3.8h12.8c.9-.9 1.4-2.2 1.4-3.8 0-2.7-1.3-4.7-2.8-6.7-1-1.4-.8-2.2-.8-3.6 0-2.7-1.5-4.8-4.2-4.8z"
      />
      {/* Belly. */}
      <path fill="#FFFFFF" d="M12 9.6c-2.2 0-3.9 2.5-3.9 5.6 0 2 .7 3.7 1.8 4.9h4.2c1.1-1.2 1.8-2.9 1.8-4.9 0-3.1-1.7-5.6-3.9-5.6z" />
      {/* Eyes. */}
      <ellipse cx="10.55" cy="5.5" rx="1.05" ry="1.3" fill="#FFFFFF" />
      <ellipse cx="13.45" cy="5.5" rx="1.05" ry="1.3" fill="#FFFFFF" />
      <circle cx="10.8" cy="5.75" r="0.5" fill="#141516" />
      <circle cx="13.2" cy="5.75" r="0.5" fill="#141516" />
      {/* Beak. */}
      <path fill={`url(#${id}t)`} d="M9.9 7.7c.6-.5 1.3-.75 2.1-.75s1.5.25 2.1.75c-.35 1-1.15 1.7-2.1 1.7s-1.75-.7-2.1-1.7z" />
      {/* Feet. */}
      <path
        fill={`url(#${id}t)`}
        d="M3.2 19.9c-.45.7 0 1.6.9 2 1.8.9 4.3 1.1 5.8.5.8-.35.9-1.1.35-1.8-1-1.1-2.7-2.1-4.5-2.1-1.1 0-2.1.6-2.55 1.4zm17.6 0c.45.7 0 1.6-.9 2-1.8.9-4.3 1.1-5.8.5-.8-.35-.9-1.1-.35-1.8 1-1.1 2.7-2.1 4.5-2.1 1.1 0 2.1.6 2.55 1.4z"
      />
    </svg>
  )
}
