---
// Site footer, the same on every marketing page: the foot of the frame, light
// and quiet (docs/WEBSITE.md, Character). The logo with one line, three short
// link columns, and the copyright. The source link here is the page's only
// mention of the project being open source.
import lockup from "../../../../brand/svg/lockup-horizontal-on-light.svg";
import { t } from "../i18n";

const groups = [
  {
    heading: t("footer.product"),
    links: [
      { href: "/download/", label: t("footer.download") },
      { href: "/benchmarks/", label: t("footer.benchmarks") },
      { href: "/changelog/", label: t("footer.changelog") },
    ],
  },
  {
    heading: t("footer.docs"),
    links: [
      { href: "/docs/getting-started/", label: t("footer.install") },
      { href: "/docs/cli/", label: t("footer.cli") },
      { href: "/docs/cli/scripting/", label: t("footer.scripting") },
    ],
  },
  {
    heading: t("footer.project"),
    links: [
      { href: t("site.repo"), label: t("footer.source") },
      { href: t("site.repoBlob", { path: "SECURITY.md" }), label: t("footer.security") },
      { href: "/privacy/", label: t("footer.privacy") },
    ],
  },
];
const height = 22;
const width = Math.round((lockup.width / lockup.height) * height);
---

<footer class="footer">
  <div class="wrap"><div class="grid">
    <div class="about">
      <img src={lockup.src} width={width} height={height} alt={t("site.name")} />
      <p>{t("footer.tagline")}</p>
    </div>
    <nav aria-label={t("footer.nav")}>
      {
        groups.map((g) => (
          <div>
            <h2>{g.heading}</h2>
            <ul>
              {g.links.map((l) => (
                <li>
                  <a href={l.href}>{l.label}</a>
                </li>
              ))}
            </ul>
          </div>
        ))
      }
    </nav>
  </div></div>
  <div class="wrap">
    <p class="base">{t("footer.credit")}</p>
  </div>
</footer>

<style>
  .footer {
    margin-top: var(--section-gap);
    font-size: 0.875rem;
  }
  .grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.4fr);
    gap: 2.5rem 3rem;
    padding-block: 3.5rem 3rem;
    border-top: 1px solid rgb(17 17 17 / 0.06);
  }
  .about {
    display: grid;
    align-content: start;
    gap: 0.875rem;
  }
  .about p {
    font-family: var(--font-serif);
    font-size: 1.0625rem;
    color: var(--ink-78);
  }
  nav {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 2rem;
  }
  h2 {
    font-size: 0.8125rem;
    font-weight: 500;
    letter-spacing: 0;
    color: var(--ink);
  }
  ul {
    display: grid;
    gap: 0.6rem;
    margin: 1rem 0 0;
    padding: 0;
    list-style: none;
  }
  a {
    color: var(--text-muted);
    text-decoration: none;
    transition: color 0.2s;
  }
  a:hover {
    color: var(--ink);
  }
  .base {
    padding-block: 1.25rem 1.75rem;
    color: var(--text-muted);
    font-size: 0.8125rem;
  }
  @media (max-width: 48rem) {
    .grid {
      grid-template-columns: minmax(0, 1fr);
    }
  }
  @media (max-width: 30rem) {
    nav {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
</style>
