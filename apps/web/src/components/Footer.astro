---
import { t } from "../i18n";

const links = [
  { href: "/docs/", label: t("footer.docs") },
  { href: "/changelog/", label: t("footer.changelog") },
  { href: "/privacy/", label: t("footer.privacy") },
  { href: t("site.repoBlob", { path: "SECURITY.md" }), label: t("footer.security") },
  { href: t("site.repo"), label: t("footer.source") },
];
---

<footer class="footer">
  <div class="wrap row">
    <div class="about">
      <p class="license">{t("footer.license")}</p>
      <p class="credit">{t("footer.credit")}</p>
    </div>
    <nav aria-label={t("footer.nav")}>
      <ul>
        {
          links.map((link) => (
            <li>
              <a href={link.href}>{link.label}</a>
            </li>
          ))
        }
      </ul>
    </nav>
  </div>
</footer>

<style>
  .footer {
    margin-top: 6rem;
    border-top: 1px solid var(--border);
    padding-block: 2.5rem 3rem;
    font-size: 0.875rem;
  }
  .row {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 1.5rem 3rem;
  }
  .license {
    color: var(--text);
  }
  .credit {
    margin-top: 0.25rem;
    color: var(--text-subtle);
  }
  ul {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.5rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  a {
    color: var(--text-muted);
    text-decoration: none;
  }
  a:hover {
    color: var(--text);
    text-decoration: underline;
  }
</style>
