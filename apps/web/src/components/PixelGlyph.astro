---
// A small illustration drawn on the mark's grid: square pixels, 10/12 pitch.
// Pattern characters: "#" lit (mark gradient), "+" half lit, "." resting,
// " " empty.
interface Props {
  pattern: string[];
  id: string;
}

const { pattern, id } = Astro.props;
const PITCH = 12;
const PIXEL = 10;
const cols = Math.max(...pattern.map((r) => r.length));
const width = cols * PITCH - (PITCH - PIXEL);
const height = pattern.length * PITCH - (PITCH - PIXEL);
const cells = pattern.flatMap((row, y) =>
  [...row].map((c, x) => ({ c, x: x * PITCH, y: y * PITCH })).filter((cell) => cell.c !== " "),
);
const gradient = `glyph-${id}`;
---

<svg
  class="glyph"
  viewBox={`0 0 ${width} ${height}`}
  width={width}
  height={height}
  aria-hidden="true"
  focusable="false"
>
  <defs>
    <linearGradient id={gradient} gradientUnits="userSpaceOnUse" x1="0" y1="0" x2={width} y2={height}>
      <stop offset="0" stop-color="#A7F3D0"></stop>
      <stop offset="0.5" stop-color="#34D399"></stop>
      <stop offset="1" stop-color="#059669"></stop>
    </linearGradient>
  </defs>
  {
    cells.map((cell) => (
      <rect
        x={cell.x}
        y={cell.y}
        width={PIXEL}
        height={PIXEL}
        fill={cell.c === "." ? "#27272A" : `url(#${gradient})`}
        opacity={cell.c === "+" ? 0.4 : 1}
      />
    ))
  }
</svg>

<style>
  .glyph {
    height: 2.75rem;
    width: auto;
  }
</style>
