---
// Questions on Home (docs/WEBSITE.md, Home as built): a short list of
// native <details> (one open at a time through their shared name, no
// JavaScript; they ease open like every disclosure, global.css), the heading on the left on wide screens. The same questions
// and answers go into FAQPage structured data for search engines.
import { t } from "../../i18n";
import en from "../../i18n/en.json";

type Item = { q: string; a: string; link?: string; href?: string };
const items = Object.values(en.home.faq.items) as unknown as Item[];

const ld = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: items.map((i) => ({
    "@type": "Question",
    name: i.q,
    acceptedAnswer: { "@type": "Answer", text: i.a },
  })),
});
---

<div class="wrap faq">
  <div class="head" data-reveal>
    <h2 id="faq-title">{t("home.faq.heading")}</h2>
    <p class="lede">{t("home.faq.lede")}</p>
  </div>
  <div class="list" data-reveal>
    {
      items.map((item) => (
        <details name="faq">
          <summary>
            <span class="q">{item.q}</span>
            <span class="sign" aria-hidden="true" />
          </summary>
          <div class="a">
            <p>
              {item.a}
              {item.link && item.href && (
                <>
                  {" "}
                  <a class="tlink" href={item.href}>
                    {item.link}
                  </a>
                </>
              )}
            </p>
          </div>
        </details>
      ))
    }
  </div>
  <script type="application/ld+json" set:html={ld} />
</div>

<style>
  .faq {
    display: grid;
    grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.2fr);
    gap: clamp(2rem, 6vw, 5.5rem);
    align-items: start;
  }
  .head {
    position: sticky;
    top: calc(var(--header-h) + var(--header-top) * 2 + 1.5rem);
  }
  h2 {
    font-size: var(--type-section);
    font-weight: 400;
    line-height: 1.08;
    letter-spacing: -0.03em;
    color: var(--ink);
  }
  .head .lede {
    margin-top: 1.25rem;
    max-width: 24rem;
  }
  .list {
    border-top: 1px solid rgb(10 10 11 / 0.09);
  }
  details {
    border-bottom: 1px solid rgb(10 10 11 / 0.09);
  }
  summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    padding: 1.35rem 0.25rem;
    font-size: 1.0625rem;
    font-weight: 500;
    letter-spacing: -0.01em;
    color: var(--ink);
    border-radius: 6px;
    transition: color 0.2s var(--ease-out);
  }
  summary:hover .q {
    text-decoration: underline;
    text-decoration-color: rgb(10 10 11 / 0.25);
    text-underline-offset: 0.3em;
  }
  summary:focus-visible {
    outline: 2px solid var(--ink);
    outline-offset: 2px;
  }
  /* A plus drawn with two hairlines; the upright one folds away when open. */
  .sign {
    position: relative;
    flex: none;
    width: 1.75rem;
    height: 1.75rem;
    border-radius: 999px;
    background: var(--white);
    box-shadow:
      0 0 0 1px rgb(10 10 11 / 0.09),
      0 1px 2px rgb(10 10 11 / 0.05);
    transition:
      background-color 0.22s var(--ease-out),
      box-shadow 0.22s var(--ease-out);
  }
  .sign::before,
  .sign::after {
    content: "";
    position: absolute;
    left: 50%;
    top: 50%;
    width: 0.625rem;
    height: 1.5px;
    margin: -0.75px 0 0 -0.3125rem;
    border-radius: 1px;
    background: var(--ink);
    transition:
      transform 0.28s var(--ease-out),
      background-color 0.22s var(--ease-out);
  }
  .sign::after {
    transform: rotate(90deg);
  }
  details[open] .sign {
    background: var(--ink);
    box-shadow: 0 0 0 1px var(--ink);
  }
  details[open] .sign::before,
  details[open] .sign::after {
    background: var(--white);
  }
  details[open] .sign::after {
    transform: rotate(0deg);
  }
  .a {
    padding: 0 3.5rem 1.5rem 0.25rem;
  }
  .a p {
    max-width: 38rem;
    font-family: var(--font-serif);
    font-size: 1.0625rem;
    line-height: 1.6;
    color: var(--ink-78);
  }
  .a .tlink {
    font-family: var(--font-sans);
    font-size: 0.9375rem;
    font-weight: 500;
    color: var(--ink);
  }
  @media (max-width: 60rem) {
    .faq {
      grid-template-columns: minmax(0, 1fr);
    }
    .head {
      position: static;
      text-align: center;
      display: grid;
      justify-items: center;
    }
  }
  @media (max-width: 34rem) {
    .a {
      padding-right: 0.25rem;
    }
    summary {
      font-size: 1rem;
      padding-block: 1.15rem;
    }
  }
</style>
