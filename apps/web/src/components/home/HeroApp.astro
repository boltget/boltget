---
// The Home hero's centerpiece: a live recreation of the desktop app's window
// in light theme, built from its source (apps/desktop/src: TitleBar, Sidebar,
// list Row, DetailsPane, FileMap, Sparkline, AddSheet; tokens from
// packages/ui). It is drawn here at build time in the same lively state as
// the app screenshot it replaced (src/assets/app-light.webp, kept for
// reference), so it is complete without JavaScript. The browser script
// (lib/herodemo.ts) lets the visitor pick a file and watch it download on the
// seeded simulation (lib/sim.ts), and plays one once by itself after the
// entrance. The window is laid out at 1280 x 780 and scaled to fit, so on a
// phone it stays faithful instead of reflowing.
import { t } from "../../i18n";
import en from "../../i18n/en.json";
import { BUNNY, BUNNY_AT, Fmt, grid, samplesOf, simFor, workers } from "../../lib/appdemo";
import { appMark, icon, mapSvg, paneHtml, rowHtml, runningStats, runningStatus, type RowModel } from "../../lib/appmarkup";

const ui = en.home.app.ui;
const fmt = new Fmt(ui);
const rows = en.home.app.rows;
const chips = en.home.app.chips;

// The selected download: a little past half, its numbers from the simulation.
const bunny = simFor(BUNNY);
while (bunny.downloaded < BUNNY_AT && !bunny.finished) bunny.step();
const samples = samplesOf(bunny);
const peak = Math.max(...samples);
const g = grid();

const active: RowModel[] = [
  {
    id: "ubuntu",
    name: rows.ubuntu.file,
    state: "downloading",
    fraction: 0.072,
    status: fmt.join(fmt.join(fmt.progress(440, 6113), fmt.speed(8.7)), fmt.eta(660)),
    rest: fmt.percent(7),
  },
  {
    id: "blender",
    name: rows.blender.file,
    state: "downloading",
    fraction: 0.933,
    status: fmt.join(fmt.join(fmt.progress(319, 342), fmt.speed(21.9)), fmt.eta(2)),
    rest: fmt.percent(93),
  },
  {
    id: "bunny",
    name: rows.bunny.file,
    state: "downloading",
    fraction: bunny.downloaded / bunny.o.total,
    status: runningStatus(bunny, fmt),
    rest: fmt.percent((bunny.downloaded / bunny.o.total) * 100),
  },
];
const waiting: RowModel[] = [
  {
    id: "lecture",
    name: rows.lecture.file,
    state: "paused",
    fraction: 0.18,
    status: fmt.join(fmt.progress(3.22, 18), rows.lecture.host),
    rest: ui.paused,
    restIcon: "pause",
  },
];
// Finished earlier today; the browser fills in the times (relative to now).
const today: RowModel[] = (
  [
    ["obs", 153],
    ["node", 29],
    ["vscode", 101],
    ["fedora", 2294],
    ["libreoffice", 350],
    ["sintel", 4413],
    ["photos", 1833],
  ] as const
).map(([id, size]) => ({
  id,
  name: rows[id].file,
  state: "completed",
  fraction: 1,
  status: fmt.join(fmt.bytes(size), rows[id].host),
  rest: "",
}));

const pane = paneHtml(
  {
    name: rows.bunny.file,
    sub: fmt.join(rows.bunny.host, fmt.bytes(BUNNY.total)),
    complete: false,
    stats: runningStats(bunny, ui, fmt),
    note: fmt.mapNote(bunny.active),
    samples,
    peak: fmt.peak(peak),
    workers: workers(bunny),
    pathLabel: ui.saving,
    path: ui.folder + rows.bunny.file,
    url: rows.bunny.url,
    map: mapSvg(bunny, g),
  },
  ui,
  fmt,
);

const views = [
  { icon: "all", label: ui.all, n: "all", count: 11, current: true },
  { icon: "active", label: ui.active, n: "active", count: 3 },
  { icon: "completed", label: ui.completed, n: "completed", count: 7 },
  { icon: "scheduled", label: ui.scheduled, n: "scheduled", count: 0 },
] as const;
const categories = [
  ["video", ui.video],
  ["music", ui.music],
  ["archives", ui.archives],
  ["programs", ui.programs],
  ["documents", ui.documents],
  ["other", ui.other],
] as const;
const chipList = (["iso", "film", "game"] as const).map((key) => ({ key, label: chips[key].label }));
// What the browser script needs: the app's strings and the files on offer.
const data = JSON.stringify({ ui, chips });
---

<figure class="hero-app" aria-label={t("home.app.label")} data-hero-app data-app={data}>
  <div class="try" data-try hidden>
    <span class="try-label" id="hero-app-try">{t("home.app.try")}</span>
    <span class="chips" role="group" aria-labelledby="hero-app-try">
      {chipList.map((c) => <button type="button" class="button button-chip" data-chip={c.key}>{c.label}</button>)}
    </span>
  </div>
  <div class="bezel">
    <div class="screen">
      <div class="win" aria-hidden="true" inert>
        <div class="tb">
          <div class="tb-brand"><Fragment set:html={appMark()} /><span>{ui.name}</span></div>
          <div class="tb-search">
            <Fragment set:html={icon("search")} /><span class="ph">{ui.search}</span>
            <span class="keys"><span class="key">{ui.ctrl}</span><span class="key">{ui.f}</span></span>
          </div>
          <div class="tb-actions"><span class="btn primary" data-add><Fragment set:html={icon("plus")} />{ui.add}</span></div>
          <div class="caps">
            <span class="cap"><svg viewBox="0 0 10 10"><path d="M0 5.5h10"></path></svg></span>
            <span class="cap"><svg viewBox="0 0 10 10"><path d="M.5.5h9v9h-9Z"></path></svg></span>
            <span class="cap"><svg viewBox="0 0 10 10"><path d="M.5.5l9 9M9.5.5l-9 9"></path></svg></span>
          </div>
        </div>
        <div class="body">
          <nav class="side">
            <ul class="group">
              {
                views.map((v) => (
                  <li class:list={["item", { current: "current" in v }]}>
                    <Fragment set:html={icon(v.icon)} />
                    <span class="lbl">{v.label}</span>
                    <span class="count" data-n={v.n}>{v.count}</span>
                  </li>
                ))
              }
            </ul>
            <p class="heading">{ui.categories}</p>
            <ul class="group">
              {
                categories.map(([name, label]) => (
                  <li class="item">
                    <Fragment set:html={icon(name)} />
                    <span class="lbl">{label}</span>
                  </li>
                ))
              }
            </ul>
            <p class="heading heading-row">{ui.queues}<Fragment set:html={icon("plus", 14)} /></p>
            <ul class="group">
              <li class="item">
                <Fragment set:html={icon("queue")} /><span class="lbl">{ui.main}</span><span class="count" data-n="main">4</span>
              </li>
            </ul>
            <ul class="group foot">
              <li class="item"><Fragment set:html={icon("settings")} /><span class="lbl">{ui.settings}</span></li>
            </ul>
          </nav>
          <div class="content">
            <div class="list">
              <div class="lhead">
                <span class="ltitle">{ui.all}</span><span class="lcount" data-n="all">11</span>
                <span class="opts"><span class="ib"><Fragment set:html={icon("sort")} /></span><span class="ib pressed"><Fragment set:html={icon("pane")} /></span></span>
              </div>
              <div class="lbody">
                <div class="sec">{ui.active}<span class="scount" data-n="active">3</span></div>
                <div class="rows" data-rows="active">
                  {active.map((r) => <Fragment set:html={rowHtml(r, r.id === "bunny")} />)}
                </div>
                <div class="sec">{ui.waiting}<span class="scount">1</span></div>
                <div class="rows">{waiting.map((r) => <Fragment set:html={rowHtml(r)} />)}</div>
                <div class="sec">{ui.today}<span class="scount" data-n="today">7</span></div>
                <div class="rows" data-rows="today">{today.map((r) => <Fragment set:html={rowHtml(r)} />)}</div>
              </div>
            </div>
            <aside class="pane" data-pane set:html={pane} />
          </div>
        </div>
        <div class="scrim" data-scrim></div>
        <div class="sheet" data-sheet>
          <div class="s-head"><span class="s-title">{ui.sheetTitle}</span><span class="ib"><Fragment set:html={icon("close")} /></span></div>
          <div class="s-link" data-s="link"></div>
          <div class="s-card">
            <span class="s-type" data-s="type"></span>
            <div class="s-text"><p class="s-name" data-s="name"></p><p class="s-meta" data-s="meta"></p></div>
          </div>
          <div class="s-row">
            <span class="s-label">{ui.saveTo}</span>
            <span class="s-folder"><Fragment set:html={icon("folder")} /><span>{ui.folder}</span><Fragment set:html={icon("down", 14)} /></span>
          </div>
          <div class="s-foot"><span class="btn secondary">{ui.cancel}</span><span class="btn primary" data-s="go">{ui.download}</span></div>
        </div>
      </div>
    </div>
  </div>
  <figcaption class="caption" aria-hidden="true">{t("home.app.caption")}</figcaption>
</figure>

<style is:global>
  /* The app's light theme (packages/ui tokens), scoped to the recreation. */
  .hero-app {
    --c-chrome: var(--graphite-50);
    --c-content: var(--white);
    --c-hairline: rgb(10 10 11 / 0.08);
    --c-hairline-strong: rgb(10 10 11 / 0.14);
    --c-stroke: var(--graphite-500);
    --c-text: var(--ink);
    --c-muted: var(--graphite-700);
    --c-subtle: var(--graphite-600);
    --c-accent: var(--ink);
    --c-accent-press: var(--graphite-800);
    --c-accent-tint: rgb(10 10 11 / 0.06);
    --c-hover: rgb(10 10 11 / 0.04);
    --c-press: rgb(10 10 11 / 0.08);
    --c-track: rgb(10 10 11 / 0.08);
    --c-idle: var(--graphite-400);
    --c-paused: var(--paused);
    --c-shadow: rgb(10 10 11 / 0.12);
    --g-progress: var(--gradient-progress-light);
    --app-w: 1280;
    --app-h: 780;
    position: relative;
    max-width: 70rem;
    margin: 0 auto;
  }

  /* "Try it": a quiet line of three file buttons above the window. */
  .hero-app .try {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: 0.5rem 0.75rem;
    margin-bottom: 1rem;
    font-size: 0.8125rem;
    color: var(--graphite-700);
  }
  .hero-app .try[hidden] {
    display: none;
  }
  .hero-app .chips {
    display: inline-flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.5rem;
  }
  .hero-app .caption {
    margin-top: 0.875rem;
    text-align: center;
    font-size: 0.75rem;
    color: var(--text-subtle);
  }

  /* The glass bezel and the scaled screen. */
  .hero-app .bezel {
    padding: clamp(4px, 0.6vw, 8px);
    border-radius: clamp(10px, 1.6vw, 20px);
    background: rgb(255 255 255 / 0.55);
    -webkit-backdrop-filter: blur(12px);
    backdrop-filter: blur(12px);
    box-shadow:
      0 0 0 1px rgb(255 255 255 / 0.7) inset,
      0 0 0 1px rgb(10 10 11 / 0.06),
      0 2px 6px rgb(10 10 11 / 0.06),
      0 40px 80px -32px rgb(10 10 11 / 0.28),
      0 80px 120px -60px rgb(10 10 11 / 0.18);
  }
  .hero-app .screen {
    position: relative;
    container-type: inline-size;
    aspect-ratio: 1280 / 780;
    overflow: hidden;
    border-radius: clamp(6px, 1.1vw, 13px);
    box-shadow: 0 0 0 1px rgb(10 10 11 / 0.08);
    background: var(--c-chrome);
  }
  .hero-app .win {
    --k: tan(atan2(100cqw, 1280px));
    position: absolute;
    top: 0;
    left: 0;
    width: 1280px;
    height: 780px;
    display: grid;
    grid-template-rows: 44px minmax(0, 1fr);
    transform: scale(var(--k));
    transform-origin: 0 0;
    background: var(--c-chrome);
    color: var(--c-text);
    font-family: var(--font-sans);
    font-size: 13px;
    line-height: 18px;
    font-variant-numeric: tabular-nums;
    text-align: left;
    user-select: none;
    -webkit-user-select: none;
    cursor: default;
  }
  .hero-app .win p,
  .hero-app .win h2,
  .hero-app .win h3,
  .hero-app .win dl,
  .hero-app .win dd,
  .hero-app .win ul {
    margin: 0;
    padding: 0;
    font: inherit;
    letter-spacing: normal;
    text-wrap: initial;
  }
  .hero-app .win ul {
    list-style: none;
  }
  .hero-app .win svg {
    display: block;
    max-width: none;
  }
  .hero-app .i {
    flex: none;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.25;
    stroke-linecap: square;
    stroke-linejoin: miter;
  }

  /* Controls. */
  .hero-app .btn {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    height: 28px;
    padding: 0 12px;
    border: 1px solid transparent;
    border-radius: 4px;
    font-weight: 500;
    white-space: nowrap;
    transition: background-color 0.12s linear;
  }
  .hero-app .btn .i {
    margin-left: -4px;
  }
  .hero-app .btn.primary {
    background: var(--c-accent);
    color: var(--white);
  }
  .hero-app .btn.primary.press {
    background: var(--c-accent-press);
  }
  .hero-app .btn.secondary {
    background: var(--white);
    border-color: var(--c-hairline-strong);
  }
  .hero-app .ib {
    display: inline-grid;
    place-items: center;
    width: 28px;
    height: 28px;
    border-radius: 4px;
    color: var(--c-muted);
  }
  .hero-app .ib.pressed {
    background: var(--c-press);
  }

  /* Title bar. */
  .hero-app .tb {
    display: flex;
    align-items: center;
    height: 44px;
  }
  .hero-app .tb-brand {
    display: flex;
    align-items: center;
    gap: 8px;
    width: 224px;
    padding-left: 16px;
    font-weight: 600;
    letter-spacing: -0.005em;
  }
  .hero-app .tb-brand svg {
    display: block;
  }
  .hero-app .tb-search {
    display: flex;
    align-items: center;
    gap: 8px;
    flex: 0 1 380px;
    height: 28px;
    padding: 0 4px 0 8px;
    border: 1px solid var(--c-hairline-strong);
    border-bottom-color: var(--c-stroke);
    border-radius: 4px;
    background: var(--white);
    color: var(--c-subtle);
  }
  .hero-app .ph {
    flex: 1;
  }
  .hero-app .keys {
    display: inline-flex;
    gap: 2px;
  }
  .hero-app .key {
    display: inline-grid;
    place-items: center;
    min-width: 18px;
    height: 18px;
    padding: 0 5px;
    border: 1px solid var(--c-hairline-strong);
    border-bottom-width: 2px;
    border-radius: 4px;
    background: var(--white);
    color: var(--c-muted);
    font-size: 11px;
    line-height: 1;
    font-weight: 500;
  }
  .hero-app .tb-actions {
    margin-left: auto;
    padding: 0 12px;
  }
  .hero-app .caps {
    display: flex;
    align-self: stretch;
  }
  .hero-app .cap {
    display: grid;
    place-items: center;
    width: 46px;
  }
  .hero-app .cap svg {
    width: 10px;
    height: 10px;
    fill: none;
    stroke: currentColor;
    stroke-width: 1;
  }

  /* Sidebar. */
  .hero-app .body {
    display: flex;
    min-height: 0;
  }
  .hero-app .side {
    display: flex;
    flex-direction: column;
    flex: none;
    width: 224px;
    padding: 4px 8px 8px;
  }
  .hero-app .group {
    display: flex;
    flex-direction: column;
    gap: 1px;
  }
  .hero-app .group.foot {
    margin-top: auto;
  }
  .hero-app .item {
    position: relative;
    display: flex;
    align-items: center;
    gap: 12px;
    height: 32px;
    padding: 0 12px;
    border-radius: 4px;
    color: var(--c-muted);
  }
  .hero-app .item.current {
    background: var(--c-accent-tint);
    color: var(--c-text);
    font-weight: 500;
  }
  .hero-app .item.current::before {
    content: "";
    position: absolute;
    left: 0;
    top: 8px;
    bottom: 8px;
    width: 2px;
    background: var(--c-accent);
  }
  .hero-app .item.current .i {
    color: var(--c-accent);
  }
  .hero-app .lbl {
    flex: 1;
  }
  .hero-app .count {
    color: var(--c-subtle);
    font-size: 12px;
    font-weight: 400;
  }
  .hero-app .heading {
    margin: 20px 0 4px;
    padding: 0 12px;
    color: var(--c-subtle);
    font-size: 12px;
    line-height: 16px;
    font-weight: 500;
  }
  .hero-app .heading-row {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding-right: 10px;
  }

  /* Content: the list and the details pane. */
  .hero-app .content {
    position: relative;
    display: flex;
    flex: 1;
    min-width: 0;
    overflow: hidden;
    background: var(--c-content);
    border-top: 1px solid var(--c-hairline);
    border-left: 1px solid var(--c-hairline);
    border-top-left-radius: 8px;
  }
  .hero-app .list {
    display: flex;
    flex-direction: column;
    flex: 1;
    min-width: 0;
  }
  .hero-app .lhead {
    display: flex;
    align-items: center;
    gap: 8px;
    height: 48px;
    padding: 0 12px 0 24px;
    flex: none;
  }
  .hero-app .ltitle {
    font-size: 15px;
    line-height: 20px;
    font-weight: 600;
    letter-spacing: -0.005em;
  }
  .hero-app .lcount {
    color: var(--c-subtle);
  }
  .hero-app .opts {
    display: flex;
    gap: 2px;
    margin-left: auto;
  }
  .hero-app .lbody {
    flex: 1;
    min-height: 0;
    overflow: hidden;
    padding: 0 8px;
  }
  .hero-app .sec {
    display: flex;
    align-items: flex-end;
    gap: 8px;
    height: 36px;
    padding: 0 16px 8px;
    color: var(--c-subtle);
    font-size: 12px;
    line-height: 16px;
    font-weight: 500;
  }
  .hero-app .scount {
    font-weight: 400;
    opacity: 0.8;
  }
  .hero-app .row {
    position: relative;
    display: flex;
    align-items: center;
    gap: 12px;
    height: 40px;
    padding: 0 8px 0 16px;
    border-radius: 4px;
  }
  .hero-app .row.selected {
    background: var(--c-accent-tint);
  }
  .hero-app .row.selected::before {
    content: "";
    position: absolute;
    left: 0;
    top: 8px;
    bottom: 8px;
    width: 2px;
    background: var(--c-accent);
  }
  .hero-app .row.enter {
    overflow: hidden;
    animation: ha-row-in 0.32s cubic-bezier(0, 0, 0, 1) both;
  }
  @keyframes ha-row-in {
    from {
      height: 0;
      opacity: 0;
    }
  }
  .hero-app .type {
    display: inline-flex;
    flex: none;
    color: var(--c-subtle);
  }
  .hero-app .selected .type {
    color: var(--c-muted);
  }
  /* A finished file: an ink tile with a pixel check, drawn on whole pixels. */
  .hero-app .type.done {
    color: var(--c-accent);
  }
  .hero-app .type.done .tile {
    fill: currentColor;
  }
  .hero-app .type.done .ck {
    fill: none;
    stroke: var(--c-content);
    stroke-width: 2;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  .hero-app .text {
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 3px;
    flex: 1;
    min-width: 0;
  }
  .hero-app .name {
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .hero-app .line2 {
    display: flex;
    align-items: center;
    gap: 8px;
    min-width: 0;
    height: 16px;
  }
  .hero-app .status {
    min-width: 0;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    color: var(--c-subtle);
    font-size: 12px;
    line-height: 16px;
  }
  .hero-app .bar {
    position: relative;
    flex: 0 0 clamp(72px, 18%, 160px);
    height: 4px;
    overflow: hidden;
    background: var(--c-track);
  }
  .hero-app .fill {
    position: absolute;
    inset: 0;
    transform-origin: left center;
    background: var(--c-idle);
    transition: transform 0.25s linear;
  }
  .hero-app .live .fill {
    background: var(--g-progress);
  }
  .hero-app .row[data-state="paused"] .fill {
    background: var(--c-paused);
  }
  .hero-app .sign.pause {
    color: var(--c-paused);
  }
  .hero-app .end {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: flex-end;
    flex: none;
    min-width: 72px;
    height: 100%;
  }
  .hero-app .rest {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    padding-right: 8px;
    color: var(--c-muted);
    font-size: 12px;
    white-space: nowrap;
  }
  .hero-app .sign {
    display: inline-flex;
    color: var(--c-subtle);
  }
  .hero-app .sign.check {
    color: var(--c-accent);
  }
  .hero-app .acts {
    position: absolute;
    right: 0;
    display: none;
    gap: 2px;
  }
  .hero-app .row.selected .acts {
    display: flex;
  }
  .hero-app .row.selected .rest {
    visibility: hidden;
  }

  /* Details pane. */
  .hero-app .pane {
    display: flex;
    flex-direction: column;
    gap: 24px;
    flex: none;
    width: 360px;
    padding: 16px 20px 32px;
    overflow: hidden;
    border-left: 1px solid var(--c-hairline);
    background: var(--c-content);
  }
  .hero-app .pane.swap {
    animation: ha-fade 0.22s cubic-bezier(0, 0, 0, 1);
  }
  @keyframes ha-fade {
    from {
      opacity: 0;
    }
  }
  .hero-app .phead {
    display: flex;
    flex-direction: column;
    gap: 12px;
