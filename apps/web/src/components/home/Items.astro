---
// A borderless grid of short points under a Home section, each a thin
// hairline over "**Bold lead.** plain sentence." Three columns on wide screens.

interface Props {
  items: { lead: string; body: string }[];
}
const { items } = Astro.props;
---

<ul class="items" data-reveal>
  {
    items.map((item) => (
      <li>
        <p>
          <strong>{item.lead}</strong> {item.body}
        </p>
      </li>
    ))
  }
</ul>

<style>
  .items {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 2.25rem clamp(1.5rem, 4vw, 3.5rem);
    margin: 0;
    padding: 0;
    list-style: none;
  }
  li {
    padding-top: 1.1rem;
    border-top: 1px solid rgb(17 17 17 / 0.08);
  }
  p {
    font-size: 0.9875rem;
    line-height: 1.55;
    color: var(--text-muted);
  }
  strong {
    font-weight: 500;
    color: var(--ink);
  }
  @media (max-width: 52rem) {
    .items {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  @media (max-width: 34rem) {
    .items {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
