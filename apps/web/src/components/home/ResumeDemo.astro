---
// "Never loses progress" on Home: a simulated download is killed mid-way (the
// card flickers and goes dark), then resumes from its last checkpoint and
// finishes byte-identical. Beside it, the one real figure, from the
// kill-and-resume harness (docs/ENGINE.md, Testing strategy; ROADMAP.md).
//
// The bytes after the last checkpoint are shown as lost and fetched again, as
// the engine does: progress counts only once it is on disk. Without
// JavaScript, and under reduced motion, the finished state shows. The loop
// pauses off screen.
import { t } from "../../i18n";
import SectionHead from "./SectionHead.astro";

const SQUARES = 32;
---

<section class="resume wrap" aria-labelledby="resume-title">
  <div class="copy">
    <SectionHead index="03" kicker={t("home.resume.kicker")} heading={t("home.resume.heading")} id="resume-title" note={t("home.resume.sheetNote")} />
    <p class="figure"><span class="big">{t("home.resume.figure")}</span></p>
    <p class="fbody">{t("home.resume.figureBody")}</p>
    <p class="more"><a class="tlink" href="/docs/cli/#pause-and-resume">{t("home.resume.link")}</a></p>
  </div>

  <figure class="card-wrap" aria-label={t("home.resume.label")} data-resume>
    <div class="card" data-state="done" aria-hidden="true">
      <div class="top">
        <span class="name">{t("home.resume.file")}</span>
        <span class="pct">100%</span>
      </div>
      <div class="meta">420 MiB · cdn.example.com · <span class="spd">0.0 MiB/s</span> · <span class="cn">0</span> conn</div>
      <div class="bar" style={`--n:${SQUARES}`}>
        {Array.from({ length: SQUARES }, (_, i) => <i style={`--i:${i}`} class="on" />)}
        <span class="cp" style="--at:0.5625"><span>{t("home.resume.checkpoint")}</span></span>
      </div>
      <div class="status">
        <span class="dot"></span>
        <span class="s s-running">{t("home.resume.running")}</span>
        <span class="s s-killed">{t("home.resume.killed")}</span>
        <span class="s s-resuming">{t("home.resume.resuming")}</span>
        <span class="s s-done">✓ {t("home.resume.done")}</span>
        <span class="hash">sha256 9f2c41d0…e2b4c7d1</span>
      </div>
      <div class="cmd"><span class="ps">&gt;</span> <span class="typed">{t("home.resume.command")}</span></div>
      <div class="cut" aria-hidden="true"></div>
      <div class="killed-pill" aria-hidden="true">{t("home.resume.killed")}</div>
    </div>
    <figcaption>{t("home.resume.note")}</figcaption>
  </figure>
</section>

<style>
  .resume {
    margin-top: var(--section-gap);
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.15fr);
    gap: 3rem clamp(3rem, 7vw, 7rem);
    align-items: center;
  }
  .copy {
    display: grid;
    gap: 1.25rem;
  }
  .figure {
    margin-top: 1.5rem;
  }
  .big {
    display: block;
    font-size: clamp(4.5rem, 10vw, 8.5rem);
    font-weight: 600;
    line-height: 0.9;
    letter-spacing: -0.06em;
    font-variant-numeric: tabular-nums;
    background: linear-gradient(135deg, #10b981, #047857 60%, #064e3b);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }
  .fbody {
    max-width: 24rem;
    color: var(--text-muted);
    font-size: var(--type-body);
  }
  .more .tlink {
    color: var(--accent);
  }

  .card-wrap {
    margin: 0;
  }
  .card {
    --t: 0;
    position: relative;
    overflow: hidden;
    padding: clamp(1.25rem, 3vw, 2rem);
    border-radius: 20px;
    background: #fff;
    box-shadow:
      0 0 0 1px rgb(2 44 34 / 0.06),
      0 24px 60px -24px rgb(2 44 34 / 0.28),
      0 60px 120px -48px rgb(2 44 34 / 0.2);
    transition:
      filter 0.6s var(--ease-out),
      opacity 0.6s var(--ease-out);
  }
  .top {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 1rem;
  }
  .name {
    font-weight: 600;
  }
  .pct {
    font: 400 1.75rem/1 var(--font-mono);
    letter-spacing: -0.04em;
    font-variant-numeric: tabular-nums;
  }
  .meta {
    margin-top: 0.35rem;
    font: 400 0.75rem/1.5 var(--font-mono);
    color: var(--text-subtle);
    font-variant-numeric: tabular-nums;
  }
  .bar {
    position: relative;
    display: grid;
    grid-template-columns: repeat(var(--n), minmax(0, 1fr));
    gap: 4px;
    margin-top: 1.25rem;
    padding-top: 1.6rem;
  }
  .bar i {
    aspect-ratio: 1;
    background: #e9efec;
    transition:
      background-color 0.35s var(--ease-out),
      opacity 0.35s var(--ease-out);
  }
  .bar i.on {
    /* One gradient across the bar: each square shows its own slice of it. */
    background:
      linear-gradient(180deg, rgb(255 255 255 / 0.22) 0 38%, transparent 38% 86%, rgb(2 44 34 / 0.12) 86%),
      linear-gradient(90deg, #6ee7b7, #10b981 50%, #0d9488 78%, #047857) calc(var(--i) / (var(--n) - 1) * 100%) 0 / calc(var(--n) * 100%) 100%;
  }
  .bar i.head {
    background: #06261e;
    box-shadow: 0 0 0 2px rgb(16 185 129 / 0.22);
  }
  .bar i.lost {
    background: #fde2e1;
  }
  .cp {
    position: absolute;
    top: 0;
    bottom: -6px;
    left: calc(var(--at) * 100%);
    width: 0;
    border-left: 1px dashed #047857;
    opacity: 0;
    transition: opacity 0.4s var(--ease-out);
  }
  .cp span {
    position: absolute;
    top: 0;
    left: 6px;
    font: 400 0.6875rem/1 var(--font-mono);
    color: #047857;
    white-space: nowrap;
  }
  .status {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem 0.75rem;
    margin-top: 1.25rem;
    min-height: 1.5rem;
    font-size: 0.875rem;
  }
  .dot {
    width: 8px;
    height: 8px;
    background: #10b981;
  }
  .s {
    display: none;
  }
  .hash {
    margin-left: auto;
    font: 400 0.75rem/1 var(--font-mono);
    color: var(--text-subtle);
  }
  .cmd {
    margin-top: 1.25rem;
    padding: 0.75rem 0.9rem;
    border-radius: 10px;
    background: #0c0c10;
    color: #e4e4e7;
    font: 400 0.8125rem/1.4 var(--font-mono);
    white-space: nowrap;
    overflow: hidden;
  }
  .ps {
    color: #6ee7b7;
  }
  .typed {
    display: inline-block;
    overflow: hidden;
    vertical-align: bottom;
    max-width: calc(var(--typed, 1) * 17ch);
  }
  .killed-pill {
    position: absolute;
    left: 50%;
    top: 44%;
    padding: 0.55rem 1rem;
    border-radius: 999px;
    background: #0b0b0f;
    color: #fff;
    font-size: 0.875rem;
    font-weight: 600;
    transform: translate(-50%, -50%) scale(0.96);
    opacity: 0;
    transition:
      opacity 0.3s var(--ease-out),
      transform 0.3s var(--ease-out);
  }
  .card[data-state="killed"] .killed-pill {
    opacity: 1;
    transform: translate(-50%, -50%);
    transition-delay: 0.5s;
  }
  .cut {
    position: absolute;
    inset: 0;
    background: #0b0b0f;
    opacity: 0;
    pointer-events: none;
  }
  figcaption {
    margin-top: 0.9rem;
    text-align: right;
    font-size: 0.8125rem;
    color: var(--text-subtle);
  }

  .card[data-state="running"] .s-running,
  .card[data-state="killed"] .s-killed,
  .card[data-state="resuming"] .s-resuming,
  .card[data-state="done"] .s-done {
    display: inline;
  }
  .card[data-state="done"] .s-done {
    color: #047857;
    font-weight: 600;
  }
  .card:not([data-state="done"]) .hash {
    visibility: hidden;
  }
  .card[data-state="killed"] .dot {
    background: #a1a1aa;
  }
  .card[data-state="killed"] .cp,
  .card[data-state="resuming"] .cp {
    opacity: 1;
  }
  .card[data-state="killed"] {
    filter: saturate(0.15);
  }
  .card[data-state="killed"] .cut {
    animation: cut 1.1s steps(1) both;
  }
  .card[data-state="killed"] .top,
  .card[data-state="killed"] .meta,
  .card[data-state="killed"] .bar,
  .card[data-state="killed"] .status {
    opacity: 0.4;
  }
  @keyframes cut {
    0% {
      opacity: 0.9;
    }
    8% {
      opacity: 0;
    }
    14% {
      opacity: 0.75;
    }
    20% {
      opacity: 0.1;
    }
    26% {
      opacity: 0.85;
    }
    40% {
      opacity: 0.35;
    }
    100% {
      opacity: 0.06;
    }
  }

  @media (max-width: 56rem) {
    .resume {
      grid-template-columns: minmax(0, 1fr);
    }
  }
  @media (max-width: 30rem) {
    .hash {
      margin-left: 0;
      flex-basis: 100%;
    }
  }
</style>

<script>
  // Timeline of one loop, in seconds.
  const RUN = 3.4; // 0 -> 63%
  const KILL = RUN; // power cut
  const TYPE = KILL + 1.5; // `boltget resume 7` types itself
  const RESUME = TYPE + 0.9;
  const FINISH = RESUME + 2.6; // 61% -> 100%
  const LOOP = FINISH + 3.2;
  const CUT_AT = 0.64;
  const CHECKPOINT = 0.5625; // 18 of 32 squares: the last checkpoint before the cut

  for (const fig of document.querySelectorAll<HTMLElement>("[data-resume]")) {
    if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) continue;
    const card = fig.querySelector<HTMLElement>(".card");
    const pct = fig.querySelector<HTMLElement>(".pct");
    const typed = fig.querySelector<HTMLElement>(".typed");
    const spd = fig.querySelector<HTMLElement>(".spd");
    const cn = fig.querySelector<HTMLElement>(".cn");
    const squares = [...fig.querySelectorAll<HTMLElement>(".bar i")];
    if (!card || !pct || !typed) continue;
    const n = squares.length;
    let clock = 0;
    let raf = 0;
    let last = 0;
    let visible = false;
    let shownState = "";

    const ease = (x: number) => 1 - Math.pow(1 - x, 2);
    const paint = () => {
      let f: number;
      let state: string;
      let lostFrom = -1;
      if (clock < KILL) {
        f = CUT_AT * ease(clock / RUN);
        state = "running";
      } else if (clock < RESUME) {
        f = CHECKPOINT;
        lostFrom = CHECKPOINT;
        state = "killed";
      } else if (clock < FINISH) {
        f = CHECKPOINT + (1 - CHECKPOINT) * ease((clock - RESUME) / (FINISH - RESUME));
        state = "resuming";
      } else {
        f = 1;
        state = "done";
      }
      if (state !== shownState) {
        card.dataset.state = state;
        shownState = state;
      }
      const lit = Math.floor(f * n + 1e-6);
      const lostTo = Math.floor(CUT_AT * n);
      squares.forEach((sq, i) => {
        const lost = lostFrom >= 0 && i >= lit && i < lostTo;
        sq.classList.toggle("on", i < lit);
        sq.classList.toggle("head", (state === "running" || state === "resuming") && i === lit);
        sq.classList.toggle("lost", lost);
      });
      pct.textContent = `${Math.floor(f * 100)}%`;
      const moving = state === "running" || state === "resuming";
      const wob = 1 + 0.04 * Math.sin(clock * 3.1);
      if (spd) spd.textContent = `${moving ? (46 * wob * Math.min(1, (clock % LOOP) * 2)).toFixed(1) : "0.0"} MiB/s`;
      if (cn) cn.textContent = moving ? String(clock < KILL ? Math.min(6, 4 + Math.floor(clock / 0.9)) : 6) : "0";
      const k = clock < TYPE ? 0 : Math.min(1, (clock - TYPE) / 0.7);
      typed.style.setProperty("--typed", String(k));
      typed.parentElement?.style.setProperty("visibility", clock >= KILL + 0.6 ? "visible" : "hidden");
    };

    const frame = (now: number) => {
      raf = 0;
      clock += Math.min(0.1, (now - last) / 1000);
      last = now;
      if (clock > LOOP) clock = 0;
      paint();
      if (visible && !document.hidden) raf = requestAnimationFrame(frame);
    };
    const schedule = () => {
      if (raf || !visible || document.hidden) return;
      last = performance.now();
      raf = requestAnimationFrame(frame);
    };
    new IntersectionObserver(
      ([e]) => {
        visible = e?.isIntersecting ?? false;
        schedule();
      },
      { threshold: 0.35 },
    ).observe(fig);
    document.addEventListener("visibilitychange", schedule);
    paint();
  }
</script>
