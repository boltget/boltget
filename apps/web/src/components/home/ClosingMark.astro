---
// Closing call to action on Home: the pixel arrow, large, plays the brand's
// row-by-row signature once when it scrolls into view, then a light passes
// across it (brand/BRAND.md, Pixels on the web). On the white page the mark
// is ink (the Onyx tile's tones, light to deep, across the whole mark);
// each pixel has a faint inner light; the mark sits on a very soft ink
// shadow. Without JavaScript or under reduced motion it is simply lit.
import Icon from "../Icon.astro";
import { t } from "../../i18n";

// The mark's geometry (brand/scripts/build.mjs): [firstCol, lastCol] per row.
const ROWS: [number, number][] = [
  [3, 5], [3, 5], [3, 5], [3, 5],
  [0, 8], [1, 7], [2, 6], [3, 5], [4, 4],
];
const PITCH = 12;
const PX = 10;
const cells = ROWS.flatMap(([a, b], r) => Array.from({ length: b - a + 1 }, (_, i) => ({ r, x: (a + i) * PITCH + 1, y: r * PITCH + 1 })));
const path = cells.map((c) => `M${c.x} ${c.y}h${PX}v${PX}h-${PX}z`).join("");
---

<section class="cta wrap" aria-labelledby="cta-title" data-cta>
  <svg class="mark" viewBox="0 0 108 108" width="216" height="216" role="img" aria-label={t("home.cta.mark")}>
    <defs>
      <linearGradient id="cta-g" gradientUnits="userSpaceOnUse" x1="0" y1="0" x2="108" y2="108">
        <stop offset="0" stop-color="#2C2D31" />
        <stop offset="0.5" stop-color="#151618" />
        <stop offset="1" stop-color="#0A0A0B" />
      </linearGradient>
      <linearGradient id="cta-in" x1="0" y1="0" x2="0" y2="1">
        <stop offset="0" stop-color="#fff" stop-opacity="0.16" />
        <stop offset="0.42" stop-color="#fff" stop-opacity="0.03" />
        <stop offset="0.88" stop-color="#fff" stop-opacity="0" />
        <stop offset="0.9" stop-color="#000" stop-opacity="0.3" />
        <stop offset="1" stop-color="#000" stop-opacity="0.3" />
      </linearGradient>
      <linearGradient id="cta-sweep" gradientUnits="userSpaceOnUse" x1="-40" y1="0" x2="0" y2="40">
        <stop offset="0" stop-color="#fff" stop-opacity="0" />
        <stop offset="0.5" stop-color="#fff" stop-opacity="0.55" />
        <stop offset="1" stop-color="#fff" stop-opacity="0" />
      </linearGradient>
      <clipPath id="cta-clip"><path d={path} /></clipPath>
    </defs>
    {
      ROWS.map((_, r) => (
        <g class="row" style={`--r:${r}`}>
          {cells
            .filter((c) => c.r === r)
            .map((c) => (
              <>
                <rect x={c.x} y={c.y} width={PX} height={PX} fill="url(#cta-g)" />
                <rect x={c.x} y={c.y} width={PX} height={PX} fill="url(#cta-in)" />
              </>
            ))}
        </g>
      ))
    }
    <g clip-path="url(#cta-clip)">
      <rect class="sweep" x="-40" y="-40" width="80" height="188" fill="url(#cta-sweep)" transform="rotate(0)" />
    </g>
  </svg>
  <h2 id="cta-title">{t("home.cta.heading")}</h2>
  <p class="lede">{t("home.cta.lede")}</p>
  <p class="actions">
    <a class="button button-primary" href="/download/"><Icon name="windows" size={15} class="nudge-pop" />{t("home.cta.primary")}</a>
    <a class="button button-secondary" href="/docs/">{t("home.cta.secondary")}<Icon name="arrowRight" size={15} class="nudge-x" /></a>
  </p>
</section>

<style>
  .cta {
    margin-top: var(--section-gap);
    display: grid;
    justify-items: center;
    text-align: center;
    gap: 1.25rem;
  }
  h2 {
    margin-top: 1.25rem;
    font-size: var(--type-section);
    font-weight: 400;
    line-height: 1.08;
    letter-spacing: -0.03em;
    color: var(--ink);
  }
  .mark {
    width: clamp(9rem, 18vw, 13.5rem);
    height: auto;
    overflow: visible;
    filter: drop-shadow(0 18px 28px rgb(10 10 11 / 0.16)) drop-shadow(0 2px 3px rgb(10 10 11 / 0.12));
  }
  .sweep {
    opacity: 0;
  }
  :global(.cta.play) .row {
    animation: arrive 0.9s var(--ease-out) both;
    animation-delay: calc(var(--r) * 0.12s);
  }
  :global(.cta.play) .sweep {
    animation: sweep 1.6s 1.25s var(--ease-out) both;
  }
  :global(.cta.wait) .row {
    opacity: 0.12;
  }
  @keyframes arrive {
    from {
      opacity: 0.12;
    }
  }
  @keyframes sweep {
    from {
      opacity: 1;
      transform: translate(-10px, -60px);
    }
    to {
      opacity: 1;
      transform: translate(150px, 60px);
    }
  }
  .actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.75rem;
    margin-top: 0.75rem;
  }
</style>

<script>
  for (const root of document.querySelectorAll<HTMLElement>("[data-cta]")) {
    if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) continue;
    root.classList.add("wait");
    new IntersectionObserver(
      ([e], io) => {
        if (!e?.isIntersecting) return;
        io.disconnect();
        root.classList.remove("wait");
        root.classList.add("play");
      },
      { threshold: 0.6 },
    ).observe(root.querySelector(".mark") ?? root);
  }
</script>
