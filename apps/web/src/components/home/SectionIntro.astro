---
// The centred opening of a Home section: the headline and a serif lede whose
// key phrases take the section's tint.
// The tint comes from the enclosing section (.tint-emerald and friends).
import { highlight } from "../../lib/rich";

interface Props {
  heading: string;
  lede: string;
  id: string;
}
const { heading, lede, id } = Astro.props;
---

<div class="intro" data-reveal>
  <h2 id={id}>{heading}</h2>
  <p class="lede" set:html={highlight(lede)} />
</div>

<style>
  .intro {
    display: grid;
    justify-items: center;
    gap: 1.25rem;
    max-width: 44rem;
    margin-inline: auto;
    text-align: center;
  }
  h2 {
    font-size: var(--type-section);
    font-weight: 400;
    line-height: 1.08;
    letter-spacing: -0.03em;
    color: var(--ink);
  }
  .lede {
    max-width: 38rem;
  }
</style>
