---
// The real desktop app under the Home hero: a screenshot of the UI in light
// theme (captured by scripts/app-screenshot.mjs from the app running on its
// simulated engine), in a quiet glass bezel with a long soft shadow. Served as
// AVIF and WebP at the widths it is shown at, with its size reserved.
import { Picture } from "astro:assets";
import shot from "../../assets/app-light.webp";
import { t } from "../../i18n";
---

<figure class="shot">
  <div class="bezel">
    <Picture
      src={shot}
      formats={["avif", "webp"]}
      fallbackFormat="webp"
      widths={[720, 1080, 1440, 2160, 2880]}
      sizes="(min-width: 76rem) 70rem, calc(100vw - 4rem)"
      quality={78}
      alt={t("home.shot.alt")}
      loading="eager"
      fetchpriority="high"
      decoding="async"
    />
  </div>
</figure>

<style>
  .shot {
    position: relative;
    max-width: 70rem;
    margin: 0 auto;
  }
  .bezel {
    padding: clamp(4px, 0.6vw, 8px);
    border-radius: clamp(12px, 1.6vw, 20px);
    background: rgb(255 255 255 / 0.55);
    -webkit-backdrop-filter: blur(12px);
    backdrop-filter: blur(12px);
    box-shadow:
      0 0 0 1px rgb(255 255 255 / 0.7) inset,
      0 0 0 1px rgb(17 17 17 / 0.06),
      0 2px 6px rgb(17 40 32 / 0.06),
      0 40px 80px -32px rgb(17 50 40 / 0.32),
      0 80px 120px -60px rgb(17 50 40 / 0.22);
  }
  .shot :global(img) {
    display: block;
    width: 100%;
    height: auto;
    border-radius: clamp(8px, 1.1vw, 13px);
    box-shadow: 0 0 0 1px rgb(17 17 17 / 0.08);
  }
</style>
