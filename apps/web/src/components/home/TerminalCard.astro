---
// The command-line section's card on Home (docs/WEBSITE.md, Home as built):
// a terminal running `boltget get <url>` in the CLI's own output format
// (crates/cli/src/display.rs): the "[id] file -> folder" line, the progress
// bar with bytes, percent, speed, ETA and connections, the one-line file map
// (48 cells shaded by how much of each slice has arrived) and the segment
// count, then the final "Saved ..." line and "Checksum OK". The numbers come
// from a small scripted download (11 segments, connections joining while it
// gets faster, three late take-overs), played sped up while the card is on
// screen. The finished state is in the HTML, so without JavaScript and under
// reduced motion the card is simply complete. The terminal is aria-hidden;
// the figure's label says what it shows.
import { t } from "../../i18n";

const MAP = 48;
// The file map's cells, drawn full (the finished state).
const cells = Array.from({ length: MAP });
---

<figure class="term-fig" aria-label={t("home.cli.label")} data-term>
  <div class="term" aria-hidden="true">
    <div class="chrome">
      <span class="dots"><i></i><i></i><i></i></span>
      <span class="title">{t("home.cli.term.title")}</span>
    </div>
    <pre class="screen"><code><span class="ln"><span class="ps">{t("home.cli.term.prompt")}</span> <span class="cmd" data-cmd>{t("home.cli.term.command")}</span><span class="caret" data-caret></span></span><span class="ln" data-head>  [12] {t("home.cli.term.file")} -&gt; {t("home.cli.term.folder")}</span><span class="ln live" data-live hidden><span class="spin" data-spin>⠋</span> <span data-probe>connecting</span><span data-run hidden><span class="bar"><span class="fill" data-fill></span></span> <span data-bytes></span>  <span data-prefix></span>
  <span class="dim">[<span class="map" data-map>{cells.map(() => <i class="c4" />)}</span>] <span data-segs></span></span></span></span><span class="ln out" data-out>{t("home.cli.term.saved")}</span><span class="ln out ok" data-out>{t("home.cli.term.checksum")}</span><span class="ln" data-end><span class="ps">{t("home.cli.term.prompt")}</span> <span class="caret blink"></span></span></code></pre>
  </div>
  <figcaption>{t("home.cli.caption")}</figcaption>
</figure>

<style>
  .term-fig {
    margin: 0 auto;
    max-width: 62rem;
  }
  .term {
    overflow: hidden;
    border-radius: 16px;
    background:
      radial-gradient(120% 80% at 50% -10%, rgb(255 255 255 / 0.06), transparent 60%),
      linear-gradient(180deg, var(--graphite-900), var(--graphite-950) 40%, var(--ink));
    color: var(--graphite-200);
    box-shadow:
      inset 0 1px 0 rgb(255 255 255 / 0.08),
      0 0 0 1px rgb(10 10 11 / 0.9),
      0 2px 4px rgb(10 10 11 / 0.12),
      0 30px 60px -30px rgb(10 10 11 / 0.55);
  }
  .chrome {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    height: 2.5rem;
    border-bottom: 1px solid rgb(255 255 255 / 0.06);
  }
  .dots {
    position: absolute;
    left: 1rem;
    display: flex;
    gap: 0.45rem;
  }
  .dots i {
    width: 0.625rem;
    height: 0.625rem;
    border-radius: 50%;
    background: rgb(255 255 255 / 0.13);
  }
  .title {
    font-size: 0.75rem;
    font-weight: 500;
    color: var(--graphite-500);
  }
  .screen {
    margin: 0;
    padding: clamp(1rem, 2.4vw, 1.5rem) clamp(1rem, 2.6vw, 1.75rem) clamp(1.25rem, 2.6vw, 1.75rem);
    min-height: 13.5em;
    overflow-x: auto;
    font-family: var(--font-mono);
    font-size: clamp(0.6875rem, 1.05vw, 0.8125rem);
    line-height: 1.75;
    font-variant-numeric: tabular-nums;
    font-variant-ligatures: none;
    scrollbar-width: none;
  }
  .screen code {
    font-size: inherit;
  }
  .ln {
    display: block;
  }
  .ln[hidden] {
    display: none;
  }
  .ps {
    color: var(--graphite-500);
  }
  .cmd {
    color: var(--white);
  }
  .dim,
  .out {
    color: var(--graphite-400);
  }
  .out:first-of-type {
    color: var(--graphite-200);
  }
  .ok {
    color: var(--graphite-300);
  }
  .caret {
    display: inline-block;
    width: 0.55em;
    height: 1.15em;
    margin-left: 1px;
    vertical-align: -0.2em;
    background: var(--graphite-300);
    opacity: 0;
  }
  .caret.blink,
  .typing .cmd + .caret {
    opacity: 1;
  }
  .caret.blink {
    animation: blink 1.1s steps(1) infinite;
  }
  @keyframes blink {
    50% {
      opacity: 0;
    }
  }
  .spin {
    display: inline-block;
    width: 1ch;
    color: var(--white);
  }
  /* The progress bar, 32 cells wide like the CLI's, drawn as one block. */
  .bar {
    display: inline-block;
    width: 32ch;
    height: 0.95em;
    vertical-align: -0.12em;
    background: rgb(255 255 255 / 0.07);
  }
  .fill {
    display: block;
    width: 0;
    height: 100%;
    background: linear-gradient(90deg, var(--graphite-300), var(--white));
  }
  /* The CLI's map glyphs (·░▒▓█) as cells one character wide, so they
     line up exactly whatever font the system falls back to. */
  .map {
    display: inline-flex;
    vertical-align: -0.14em;
  }
  .map i {
    width: 1ch;
    height: 1em;
  }
  .map .c0 {
    background: radial-gradient(circle, rgb(255 255 255 / 0.28) 0 1px, transparent 1.5px);
  }
  .map .c1 {
    background: rgb(255 255 255 / 0.18);
  }
  .map .c2 {
    background: rgb(255 255 255 / 0.36);
  }
  .map .c3 {
    background: rgb(255 255 255 / 0.6);
  }
  .map .c4 {
    background: rgb(255 255 255 / 0.86);
  }
  figcaption {
    margin-top: 0.875rem;
    text-align: center;
    font-size: 0.75rem;
    color: var(--text-subtle);
  }
  @media (prefers-reduced-motion: reduce) {
    .caret.blink {
      animation: none;
    }
  }
</style>

<script>
  // The scripted download (see the frontmatter). Segments are [start, end,
  // joined] in fractions of the file and of the run; each fills at a steady
  // rate from when it joins until the end, so all finish together, as work
  // stealing makes them.
  const SEGS: [number, number, number][] = [
    [0, 0.1, 0],
    [0.1, 0.21, 0.2],
    [0.21, 0.25, 0.55],
    [0.25, 0.36, 0],
    [0.36, 0.45, 0.1],
    [0.45, 0.5, 0.7],
    [0.5, 0.62, 0],
    [0.62, 0.71, 0.15],
    [0.71, 0.75, 0.8],
    [0.75, 0.86, 0],
    [0.86, 1, 0.05],
  ];
  const TOTAL = 1.25 * 1024 ** 3; // bytes
  const SECONDS = 26.8; // the simulated run
  const PLAY = 5.6; // seconds it takes on screen
  const MAP = 48;
  const SPIN = "⠋⠙⠹⠸⠼⠴⠦⠧⠇⠏";

  const filled = (u: number) =>
    SEGS.map(([a, b, j]) => (u <= j ? 0 : Math.min(1, (u - j) / (1 - j)) * (b - a)));
  const done = (u: number) => filled(u).reduce((s, x) => s + x, 0);
  // indicatif's HumanBytes: binary units, two decimals.
  const bytes = (n: number) => {
    const units = ["B", "KiB", "MiB", "GiB"];
    let i = 0;
    while (n >= 1024 && i < units.length - 1) {
      n /= 1024;
      i++;
    }
    return i === 0 ? `${Math.round(n)} B` : `${n.toFixed(2)} ${units[i]}`;
  };
  const seconds = (s: number) => {
    const n = Math.max(0, Math.round(s));
    return `${n} second${n === 1 ? "" : "s"}`;
  };
  // The CLI's shades: █ full, ▓ ≥ 2/3, ▒ ≥ 1/3, ░ some, · none.
  const shade = (f: number) => (f >= 1 ? "c4" : f >= 0.66 ? "c3" : f >= 0.33 ? "c2" : f > 0 ? "c1" : "c0");
  const map = (u: number) => {
    const out: string[] = [];
    for (let i = 0; i < MAP; i++) {
      const a = i / MAP;
      const b = (i + 1) / MAP;
      let covered = 0;
      for (const [s, e, j] of SEGS) {
        const end = s + (u <= j ? 0 : Math.min(1, (u - j) / (1 - j))) * (e - s);
        covered += Math.max(0, Math.min(end, b) - Math.max(s, a));
      }
      out.push(shade(covered / (b - a) + 1e-9));
    }
    return out;
  };

  for (const root of document.querySelectorAll<HTMLElement>("[data-term]")) {
    if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) continue;
    if (document.documentElement.classList.contains("frozen")) continue;
    const q = <T extends HTMLElement>(s: string) => root.querySelector<T>(s)!;
    const cmd = q("[data-cmd]");
    const head = q("[data-head]");
    const live = q("[data-live]");
    const end = q("[data-end]");
    const outs = [...root.querySelectorAll<HTMLElement>("[data-out]")];
    const fill = q("[data-fill]");
    const bytesEl = q("[data-bytes]");
    const prefix = q("[data-prefix]");
    const cellEls = [...q("[data-map]").children] as HTMLElement[];
    const segsEl = q("[data-segs]");
    const spin = q("[data-spin]");
    const probe = q("[data-probe]");
    const runEl = q("[data-run]");
    const text = cmd.textContent ?? "";
    const pad = (s: string, n: number, left = false) => (left ? s.padStart(n) : s.padEnd(n));

    let visible = false;
    let raf = 0;
    let t0 = 0;
    let prev = 0;
    let speed = 0;

    const reset = () => {
      cmd.textContent = "";
      head.hidden = true;
      live.hidden = true;
      end.hidden = true;
      for (const o of outs) o.hidden = true;
      speed = 0;
    };
    const draw = (u: number, dt: number) => {
      const d = done(u);
      // Speed over the last frame, smoothed like the CLI's sliding window.
      const du = Math.max(1e-4, dt);
      const inst = ((done(Math.min(1, u + du)) - d) / du) * (TOTAL / SECONDS);
      speed = speed === 0 ? inst : speed + (inst - speed) * 0.15;
      const conns = Math.min(8, SEGS.filter(([, , j]) => j <= u).length);
      const segs = SEGS.filter(([, , j]) => j <= u).length;
      const left = ((1 - d) * TOTAL) / Math.max(1, speed);
      fill.style.width = `${(d * 100).toFixed(2)}%`;
      bytesEl.textContent = `${pad(bytes(d * TOTAL), 10, true)} / ${pad(bytes(TOTAL), 10)} ${pad(`${Math.floor(d * 100)}`, 3, true)}%`;
      prefix.textContent = `${pad(bytes(speed), 10, true)}/s  ETA ${pad(seconds(left), 11)} ${pad(String(conns), 2, true)} conn`;
      map(u).forEach((c, i) => {
        const cell = cellEls[i];
        if (!cell || cell.dataset.c === c) return;
        cell.classList.remove("c0", "c1", "c2", "c3", "c4");
        cell.classList.add(c);
        cell.dataset.c = c;
      });
      segsEl.textContent = `${segs} segments`;
    };

    // Timeline (seconds from the start): type the command, print the head
    // line, run the download, print the result, hold, start over.
    const TYPE_AT = 0.5;
    const TYPE_CPS = 34;
    const typed = TYPE_AT + text.length / TYPE_CPS;
    const RUN_AT = typed + 1;
    const DONE_AT = RUN_AT + PLAY;
    const LOOP = DONE_AT + 5;

    const frame = (now: number) => {
      raf = 0;
      if (!visible || document.hidden) return;
      if (t0 === 0) t0 = now;
      let s = (now - t0) / 1000;
      if (s >= LOOP) {
        t0 = now;
        s = 0;
        prev = 0;
        reset();
      }
      if (s < typed + 0.2) {
        root.classList.add("typing");
        cmd.textContent = text.slice(0, Math.max(0, Math.floor((s - TYPE_AT) * TYPE_CPS)));
      } else if (s < DONE_AT) {
        root.classList.remove("typing");
        cmd.textContent = text;
        live.hidden = false;
        spin.textContent = SPIN[Math.floor(s * 8) % SPIN.length] ?? "";
        const running = s >= RUN_AT;
        probe.hidden = running;
        runEl.hidden = !running;
        head.hidden = !running;
        if (running) {
          const u = Math.min(1, (s - RUN_AT) / PLAY);
          draw(u, prev > RUN_AT ? (s - prev) / PLAY : 0.01);
        }
      } else {
        live.hidden = true;
        for (const o of outs) o.hidden = false;
        end.hidden = false;
      }
      prev = s;
      raf = requestAnimationFrame(frame);
    };
    const kick = () => {
      if (!visible || document.hidden || raf) return;
      // Carry on where it stopped rather than jumping ahead.
      raf = requestAnimationFrame((now) => {
        if (t0 !== 0) t0 = now - prev * 1000;
        frame(now);
      });
    };

    reset();
    new IntersectionObserver(([e]) => {
      visible = !!e?.isIntersecting;
      if (visible) kick();
    }, { threshold: 0.35 }).observe(root);
    document.addEventListener("visibilitychange", kick);
  }
</script>
