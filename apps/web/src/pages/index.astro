---
// Home (docs/WEBSITE.md, Home page): the atmospheric hero with the simulated
// app preview, then five scenes that each show one thing: how a download is
// split, measured speed, resume after a crash, the built-in details, and the
// closing mark.
import Base from "../layouts/Base.astro";
import Aurora from "../components/Aurora.astro";
import AppDemo from "../components/home/AppDemo.svelte";
import HowItWorks from "../components/home/HowItWorks.astro";
import SpeedRuns from "../components/home/SpeedRuns.astro";
import ResumeDemo from "../components/home/ResumeDemo.astro";
import Features from "../components/home/Features.astro";
import ClosingMark from "../components/home/ClosingMark.astro";
import { t } from "../i18n";

const demo = {
  preview: t("home.demo.preview"),
  appName: t("home.demo.appName"),
  nav: {
    all: t("home.demo.nav.all"),
    active: t("home.demo.nav.active"),
    completed: t("home.demo.nav.completed"),
    scheduled: t("home.demo.nav.scheduled"),
  },
  empty: t("home.demo.empty"),
  download: t("home.demo.download"),
  connecting: t("home.demo.connecting", { host: "{host}" }),
  meta: t("home.demo.meta", { size: "{size}", host: "{host}" }),
  stats: {
    speed: t("home.demo.stats.speed"),
    received: t("home.demo.stats.received"),
    left: t("home.demo.stats.left"),
    connections: t("home.demo.stats.connections"),
  },
  map: t("home.demo.map"),
  mapNote: t("home.demo.mapNote"),
  graph: t("home.demo.graph"),
  conn: {
    connecting: t("home.demo.conn.connecting"),
    receiving: t("home.demo.conn.receiving"),
    idle: t("home.demo.conn.idle"),
  },
  done: t("home.demo.done", { size: "{size}", time: "{time}" }),
  verified: t("home.demo.verified"),
  open: t("home.demo.open"),
  label: t("home.demo.label"),
  note: t("home.demo.note"),
  noteLink: t("home.demo.noteLink"),
  url: t("home.demo.file.url"),
  name: t("home.demo.file.name"),
  host: t("home.demo.file.host"),
  recent: {
    heading: t("home.demo.recent.heading"),
    done: t("home.demo.recent.done"),
    items: [
      { name: t("home.demo.recent.one"), size: "612 MiB" },
      { name: t("home.demo.recent.two"), size: "1.84 GiB" },
      { name: t("home.demo.recent.three"), size: "88 MiB" },
    ],
  },
};
---

<Base title={t("home.title")} description={t("home.description")} bareTitle header="field">
  <section class="hero" aria-labelledby="hero-title">
    <div class="sky"><Aurora /></div>
    <div class="wrap copy" data-aurora-clamp>
      <h1 id="hero-title">{t("home.headline")}</h1>
      <div class="aside">
        <p class="sentence">{t("home.sentence")}</p>
        <p class="links">
          <a class="tlink" href="/docs/getting-started/">{t("home.primary")}</a>
          <a class="tlink" href="/benchmarks/">{t("home.secondary")}</a>
        </p>
      </div>
    </div>
    <div class="wrap stage">
      <AppDemo client:load s={demo} />
    </div>
  </section>

  <HowItWorks />
  <SpeedRuns />
  <ResumeDemo />
  <Features />
  <ClosingMark />
</Base>

<style>
  .hero {
    position: relative;
    isolation: isolate;
  }
  .sky {
    position: absolute;
    inset: 0 0 auto;
    height: clamp(46rem, 100svh, 62rem);
    z-index: -1;
  }
  .copy {
    display: grid;
    grid-template-columns: minmax(0, 1.25fr) minmax(0, 1fr);
    gap: 2rem 4rem;
    align-items: end;
    padding-top: calc(var(--header-h) + clamp(3.5rem, 12vh, 8.5rem));
    padding-bottom: clamp(3rem, 8vh, 5.5rem);
    color: #fff;
  }
  h1 {
    font-size: var(--type-display);
    line-height: 0.95;
    letter-spacing: -0.055em;
    max-width: 9.5ch;
    animation: rise 1.1s var(--ease-out) both;
  }
  .aside {
    max-width: 26rem;
    padding-bottom: 0.6rem;
    animation: rise 1.1s 0.12s var(--ease-out) both;
  }
  .sentence {
    font-size: clamp(1.0625rem, 1.4vw, 1.25rem);
    line-height: 1.5;
    color: rgb(255 255 255 / 0.92);
  }
  .links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.75rem;
    margin-top: 1.5rem;
    font-size: 1rem;
  }
  .links a {
    color: #fff;
  }
  .links a:focus-visible {
    outline-color: #fff;
  }
  @keyframes rise {
    from {
      opacity: 0;
      transform: translateY(14px);
      filter: blur(6px);
    }
  }
  .stage {
    position: relative;
    max-width: 78rem;
    animation: rise 1.2s 0.25s var(--ease-out) both;
  }
  @media (max-width: 52rem) {
    .copy {
      grid-template-columns: minmax(0, 1fr);
      padding-top: calc(var(--header-h) + 2.5rem);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    h1,
    .aside,
    .stage {
      animation: none;
    }
  }
</style>
