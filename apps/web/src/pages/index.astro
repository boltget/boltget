---
// Home (docs/WEBSITE.md, Home as built): the Daylight hero panel with the real
// app overlapping its foot, then three centred sections, each in its own tint
// (Speed in emerald, resume in sky blue, Built in in violet), and the closing
// mark.
import Base from "../layouts/Base.astro";
import Icon from "../components/Icon.astro";
import AppShot from "../components/home/AppShot.astro";
import SectionIntro from "../components/home/SectionIntro.astro";
import SpeedCard from "../components/home/SpeedCard.astro";
import ResumeCard from "../components/home/ResumeCard.astro";
import Items from "../components/home/Items.astro";
import ClosingMark from "../components/home/ClosingMark.astro";
import skyAvif from "../assets/sky.avif";
import skyWebp from "../assets/sky.webp";
import { t } from "../i18n";

const skyStyle = `--sky-avif: url(${skyAvif.src}); --sky-webp: url(${skyWebp.src})`;

const speedItems = [
  { lead: t("home.speed.items.probe.lead"), body: t("home.speed.items.probe.body") },
  { lead: t("home.speed.items.split.lead"), body: t("home.speed.items.split.body") },
  { lead: t("home.speed.items.steal.lead"), body: t("home.speed.items.steal.body") },
] as const;

const builtinItems = [
  { lead: t("home.builtin.items.queues.lead"), body: t("home.builtin.items.queues.body") },
  { lead: t("home.builtin.items.limits.lead"), body: t("home.builtin.items.limits.body") },
  { lead: t("home.builtin.items.refresh.lead"), body: t("home.builtin.items.refresh.body") },
  { lead: t("home.builtin.items.proxy.lead"), body: t("home.builtin.items.proxy.body") },
  { lead: t("home.builtin.items.cli.lead"), body: t("home.builtin.items.cli.body") },
  { lead: t("home.builtin.items.verified.lead"), body: t("home.builtin.items.verified.body") },
] as const;
---

<Base title={t("home.title")} description={t("home.description")} bareTitle>
  <script is:inline slot="head">
    // Scroll reveals only with JavaScript and full motion; otherwise everything is simply there.
    if (!matchMedia("(prefers-reduced-motion: reduce)").matches) document.documentElement.classList.add("reveal");
  </script>

  <section class="hero" aria-labelledby="hero-title">
    <div class="panel">
      <div class="sky" style={skyStyle} aria-hidden="true"></div>
      <div class="copy">
        <h1 id="hero-title">
          <span class="l1">{t("home.headline.one")}</span>
          <span class="l2">{t("home.headline.two")}</span>
        </h1>
        <p class="lede">{t("home.lede")}</p>
        <p class="actions">
          <a class="button button-primary" href="/download/"><Icon name="windows" size={15} />{t("home.primary")}</a>
          <a class="button button-secondary" href="#speed">{t("home.secondary")}<Icon name="arrowDown" size={15} /></a>
        </p>
        <p class="platforms">{t("home.platforms")}</p>
        <p class="also">
          <span class="also-lead">{t("home.also.lead")}</span>
          <a class="os" href="/download/" aria-label={t("home.also.windows")}><Icon name="windows" size={12} /></a>
          <span class="os off" tabindex="0" role="img" aria-disabled="true" aria-label={t("home.also.macosSoon")} data-tip={t("home.also.soon")}><Icon name="apple" size={15} /></span>
          <span class="os off" tabindex="0" role="img" aria-disabled="true" aria-label={t("home.also.linuxSoon")} data-tip={t("home.also.soon")}><Icon name="linux" size={15} /></span>
        </p>
      </div>
      <div class="overlap" aria-hidden="true"></div>
    </div>
    <div class="stage">
      <AppShot />
    </div>
  </section>

  <section id="speed" class="section tint-emerald" aria-labelledby="speed-title">
    <div class="wrap">
      <SectionIntro
        heading={t("home.speed.heading")}
        lede={t("home.speed.lede")}
        id="speed-title"
      />
      <div class="visual" data-reveal><SpeedCard /></div>
      <Items items={[...speedItems]} />
      <p class="more" data-reveal>
        <a href="/benchmarks/">{t("home.speed.link")}<Icon name="arrowRight" size={14} /></a>
      </p>
    </div>
  </section>

  <section class="section tint-sky" aria-labelledby="resume-title">
    <div class="wrap">
      <SectionIntro
        heading={t("home.resume.heading")}
        lede={t("home.resume.lede")}
        id="resume-title"
      />
      <div class="visual" data-reveal><ResumeCard /></div>
    </div>
  </section>

  <section class="section tint-violet" aria-labelledby="builtin-title">
    <div class="wrap">
      <SectionIntro
        heading={t("home.builtin.heading")}
        lede={t("home.builtin.lede")}
        id="builtin-title"
      />
      <div class="grid"><Items items={[...builtinItems]} /></div>
      <p class="next" data-reveal>{t("home.builtin.next")}</p>
    </div>
  </section>

  <ClosingMark />
</Base>

<style>
  /* Section tints: the card wash and the highlighted phrases.
     Text tints hold at least 4.5:1 on the frame, the pill and the card. */
  .tint-emerald {
    --tint-text: #047857;
    --tint-bg: #d1fae5;
    --tint-wash: #c9f3e0;
  }
  .tint-sky {
    --tint-text: #0369a1;
    --tint-bg: #e0f2fe;
    --tint-wash: #cfe8fb;
  }
  .tint-violet {
    --tint-text: #6d28d9;
    --tint-bg: #ede9fe;
    --tint-wash: #e6e0fd;
  }

  /* Hero. */
  .hero {
    --overlap: clamp(7rem, 24vw, 21rem);
    position: relative;
    padding: 0.5rem 0.5rem 0;
  }
  .panel {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    border-radius: 18px;
    background: #eef4f1;
    box-shadow: inset 0 0 0 1px rgb(17 17 17 / 0.035);
  }
  .sky {
    position: absolute;
    inset: 0 -6% 0 0;
    z-index: -1;
    background-image: var(--sky-webp);
    background-image: image-set(var(--sky-avif) type("image/avif"), var(--sky-webp) type("image/webp"));
    background-size: cover;
    background-position: 50% 100%;
    animation: drift 140s linear infinite alternate;
  }
  @keyframes drift {
    to {
      transform: translateX(-5%);
    }
  }
  .copy {
    display: grid;
    justify-items: center;
    text-align: center;
    padding: clamp(4rem, 11vh, 7.5rem) var(--gutter) clamp(2.75rem, 6vw, 4rem);
  }
  h1 {
    font-size: var(--type-display);
    font-weight: 400;
    line-height: 1.04;
    letter-spacing: -0.03em;
    color: var(--ink);
  }
  h1 span {
    display: block;
  }
  .l1 {
    animation: rise 1.1s 0.08s var(--ease-out) both;
  }
  .l2 {
    font-family: var(--font-serif);
    font-style: italic;
    letter-spacing: -0.02em;
    animation: rise 1.1s 0.18s var(--ease-out) both;
  }
  .copy .lede {
    max-width: 33rem;
    margin-top: 1.25rem;
    animation: rise 1.1s 0.28s var(--ease-out) both;
  }
  .actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.75rem;
    margin-top: 2rem;
    animation: rise 1.1s 0.36s var(--ease-out) both;
  }
  .platforms {
    margin-top: 0.9rem;
    font-size: 0.8125rem;
    color: #4b5563;
    animation: rise 1.1s 0.42s var(--ease-out) both;
  }
  .also {
    display: flex;
    align-items: center;
    gap: 0.35rem;
    margin-top: 0.6rem;
    font-size: 0.75rem;
    color: #6b7280;
    animation: rise 1.1s 0.46s var(--ease-out) both;
  }
  .also-lead {
    margin-right: 0.2rem;
  }
  .os {
    position: relative;
    display: inline-grid;
    place-items: center;
    width: 1.625rem;
    height: 1.625rem;
    border-radius: 7px;
    color: var(--ink);
    transition:
      color 0.16s linear,
      background-color 0.16s linear;
  }
  a.os:hover {
    background: rgb(255 255 255 / 0.7);
  }
  .off {
    color: #b4bac1;
    cursor: default;
  }
  .off:hover,
  .off:focus-visible {
    color: #8a929b;
  }
  /* "Coming soon": a small CSS-only tooltip on hover and keyboard focus. */
  .off::after {
    content: attr(data-tip);
    position: absolute;
    bottom: calc(100% + 0.4rem);
    left: 50%;
    padding: 0.25rem 0.5rem;
    border-radius: 6px;
    background: var(--ink);
    color: #fff;
    font-size: 0.6875rem;
    font-weight: 500;
    line-height: 1.2;
    white-space: nowrap;
    pointer-events: none;
    opacity: 0;
    transform: translate(-50%, 3px);
    transition:
      opacity 0.14s linear,
      transform 0.14s var(--ease-out);
  }
  .off:hover::after,
  .off:focus-visible::after {
    opacity: 1;
    transform: translate(-50%, 0);
  }
  .overlap {
    height: var(--overlap);
  }
  .stage {
    position: relative;
    margin-top: calc(-1 * var(--overlap));
    padding-inline: clamp(0.75rem, 3vw, 3rem);
    animation: rise 1.3s 0.4s var(--ease-out) both;
  }
  @keyframes rise {
    from {
      opacity: 0;
      transform: translateY(14px);
      filter: blur(6px);
    }
  }

  /* Sections. */
  .section {
    margin-top: var(--section-gap);
    scroll-margin-top: 1rem;
  }
  .visual {
    margin-top: clamp(2.5rem, 5vw, 4rem);
  }
  .section :global(.items) {
    margin-top: clamp(2.5rem, 5vw, 3.75rem);
    padding-inline: clamp(0rem, 3vw, 2.5rem);
  }
  .more,
  .next {
    margin-top: 2.5rem;
    text-align: center;
    font-size: 0.9375rem;
  }
  .more a {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    color: var(--ink);
    font-weight: 500;
    text-decoration: underline;
    text-decoration-color: rgb(11 11 15 / 0.25);
    text-underline-offset: 0.3em;
  }
  .more a:hover {
    text-decoration-color: currentColor;
  }
  .next {
    color: var(--text-muted);
  }

  /* Scroll reveals (only when the head script set .reveal). */
  :global(.reveal [data-reveal]) {
    transition:
      opacity 0.6s var(--ease-out),
      transform 0.6s var(--ease-out),
      filter 0.6s var(--ease-out);
  }
  :global(.reveal [data-reveal]:not(.in)) {
    opacity: 0;
    transform: translateY(18px);
    filter: blur(6px);
  }

  @media (max-width: 40rem) {
    .hero {
      padding: 0.375rem 0.375rem 0;
    }
    .panel {
      border-radius: 15px;
    }
    .actions {
      flex-direction: column;
      align-items: stretch;
      width: min(100%, 20rem);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .sky,
    .l1,
    .l2,
    .copy .lede,
    .actions,
    .platforms,
    .also,
    .stage {
      animation: none;
    }
    .off::after {
      transition: none;
      transform: translate(-50%, 0);
    }
  }
</style>

<script>
  // Reveal each marked block once as it scrolls into view.
  const blocks = document.querySelectorAll<HTMLElement>("[data-reveal]");
  if (document.documentElement.classList.contains("reveal")) {
    const io = new IntersectionObserver(
      (entries) => {
        for (const e of entries) {
          if (!e.isIntersecting) continue;
          e.target.classList.add("in");
          io.unobserve(e.target);
        }
      },
      { rootMargin: "0px 0px -4% 0px" },
    );
    for (const b of blocks) io.observe(b);
  }
</script>
