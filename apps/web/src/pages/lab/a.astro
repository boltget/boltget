---
// Design lab, direction A ("Daylight"): light and atmospheric. See
// docs/WEBSITE.md, Redesign. Noindex; not linked from the site.
import Lab from "../../layouts/Lab.astro";
import ChunkAurora from "../../lab/ChunkAurora.astro";
import AppDemo from "../../lab/AppDemo.svelte";
import lockup from "../../../../../brand/svg/lockup-horizontal-on-dark.svg";
import { t } from "../../i18n";
import { fixed, latestRun, rowOf } from "../../lib/bench";
import { longDate } from "../../lib/format";

const run = latestRun();
const lab = rowOf(run, "lab-1gib", "boltget", "auto");
const cdn = rowOf(run, "cachefly-100mb", "boltget", "auto");

const nav = [
  { href: "/benchmarks/", label: t("nav.benchmarks") },
  { href: "/docs/", label: t("nav.docs") },
  { href: "/changelog/", label: t("nav.changelog") },
  { href: t("site.repo"), label: t("nav.github") },
];

const strings = {
  preview: t("lab.a.preview"),
  appName: t("lab.a.appName"),
  nav: {
    all: t("lab.a.nav.all"),
    active: t("lab.a.nav.active"),
    completed: t("lab.a.nav.completed"),
    scheduled: t("lab.a.nav.scheduled"),
  },
  empty: t("lab.a.empty"),
  download: t("lab.a.download"),
  connecting: t("lab.a.connecting", { host: "{host}" }),
  meta: t("lab.a.meta", { size: "{size}", host: "{host}" }),
  stats: {
    speed: t("lab.a.stats.speed"),
    received: t("lab.a.stats.received"),
    left: t("lab.a.stats.left"),
    connections: t("lab.a.stats.connections"),
  },
  map: t("lab.a.map"),
  mapNote: t("lab.a.mapNote"),
  graph: t("lab.a.graph"),
  conn: {
    connecting: t("lab.a.conn.connecting"),
    receiving: t("lab.a.conn.receiving"),
    idle: t("lab.a.conn.idle"),
  },
  done: t("lab.a.done", { size: "{size}", time: "{time}" }),
  verified: t("lab.a.verified"),
  open: t("lab.a.open"),
  demoLabel: t("lab.a.demoLabel"),
  demoNote: t("lab.a.demoNote"),
  honestyLink: t("lab.honestyLink"),
  url: t("lab.file.url"),
  name: t("lab.file.name"),
  host: t("lab.file.host"),
  recent: {
    heading: t("lab.a.recent.heading"),
    done: t("lab.a.recent.done"),
    items: [
      { name: t("lab.a.recent.one"), size: "612 MiB" },
      { name: t("lab.a.recent.two"), size: "1.84 GiB" },
      { name: t("lab.a.recent.three"), size: "88 MiB" },
    ],
  },
};

const proof = [
  { title: t("lab.a.proof.fastTitle", { value: fixed(lab.medianMibS, 1) }), body: t("lab.a.proof.fastBody", { date: longDate(run.date) }) },
  { title: t("lab.a.proof.cdnTitle", { value: fixed(cdn.medianMibS, 1) }), body: t("lab.a.proof.cdnBody") },
  { title: t("lab.a.proof.resumeTitle"), body: t("lab.a.proof.resumeBody") },
];
const lockH = 24;
const lockW = Math.round((lockup.width / lockup.height) * lockH);
---

<Lab title={t("lab.a.title")} description={t("lab.a.description")} theme="light" other={{ href: "/lab/b/", label: "B" }}>
  <section class="hero" aria-labelledby="a-title">
    <div class="sky"><ChunkAurora /></div>
    <header class="wrap top">
      <a href="/" aria-label={t("nav.home")}><img src={lockup.src} width={lockW} height={lockH} alt="" /></a>
      <nav aria-label={t("nav.label")}>
        {nav.map((n) => <a href={n.href}>{n.label}</a>)}
      </nav>
    </header>
    <div class="wrap copy">
      <h1 id="a-title">{t("lab.headline")}</h1>
      <div class="aside">
        <p class="sentence">{t("lab.sentence")}</p>
        <p class="links">
          <a class="tlink" href="/docs/getting-started/">{t("lab.primary")}</a>
          <a class="tlink" href="/benchmarks/">{t("lab.secondary")}</a>
        </p>
      </div>
    </div>
    <div class="wrap stage">
      <AppDemo client:visible s={strings} />
    </div>
  </section>

  <section class="statement wrap" aria-labelledby="a-how">
    <h2 id="a-how" class="kicker">{t("lab.a.statement.label")}</h2>
    <p class="say">{t("lab.a.statement.body")}</p>
  </section>

  <section class="proof wrap" aria-label={t("home.proof.heading")}>
    <ul>
      {
        proof.map((p) => (
          <li>
            <h3>{p.title}</h3>
            <p>{p.body}</p>
          </li>
        ))
      }
    </ul>
    <p class="more"><a class="tlink" href="/benchmarks/">{t("lab.a.proof.link")}</a></p>
  </section>

  <footer class="wrap foot">
    <p>{t("lab.status")}</p>
    <p>{t("footer.license")}</p>
  </footer>
</Lab>

<style>
  .hero {
    position: relative;
    isolation: isolate;
  }
  .sky {
    position: absolute;
    inset: 0 0 auto;
    height: clamp(46rem, 100svh, 62rem);
    z-index: -1;
  }
  .top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    height: 5rem;
  }
  .top nav {
    display: flex;
    gap: clamp(1rem, 2.5vw, 2.25rem);
    font-size: 0.875rem;
  }
  .top nav a {
    color: rgb(255 255 255 / 0.78);
    text-decoration: none;
    transition: color 0.2s;
  }
  .top nav a:hover {
    color: #fff;
  }
  .copy {
    display: grid;
    grid-template-columns: minmax(0, 1.25fr) minmax(0, 1fr);
    gap: 2rem 4rem;
    align-items: end;
    padding-top: clamp(4rem, 13vh, 9rem);
    padding-bottom: clamp(3rem, 8vh, 5.5rem);
    color: #fff;
  }
  h1 {
    font-size: clamp(3.4rem, 6.6vw, 6.25rem);
    line-height: 0.95;
    letter-spacing: -0.055em;
    max-width: 9.5ch;
    animation: rise 1.1s var(--ease-out) both;
  }
  .aside {
    max-width: 26rem;
    padding-bottom: 0.6rem;
    animation: rise 1.1s 0.12s var(--ease-out) both;
  }
  .sentence {
    font-size: clamp(1.0625rem, 1.4vw, 1.25rem);
    line-height: 1.5;
    color: rgb(255 255 255 / 0.84);
  }
  .links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.75rem;
    margin-top: 1.5rem;
    font-weight: 600;
    font-size: 1rem;
  }
  .links a {
    color: #fff;
  }
  @keyframes rise {
    from {
      opacity: 0;
      transform: translateY(14px);
      filter: blur(6px);
    }
  }
  .stage {
    position: relative;
    max-width: 78rem;
    animation: rise 1.2s 0.25s var(--ease-out) both;
  }

  .statement {
    padding-block: clamp(6rem, 14vw, 11rem) clamp(3rem, 6vw, 5rem);
  }
  .kicker {
    font: 400 0.8125rem/1 var(--font-mono);
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: #047857;
  }
  .say {
    margin-top: 1.75rem;
    max-width: 22em;
    font-size: clamp(1.75rem, 3.6vw, 3.25rem);
    line-height: 1.12;
    letter-spacing: -0.035em;
    font-weight: 600;
    color: #0b0b0f;
    text-wrap: pretty;
  }

  .proof ul {
    list-style: none;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 2rem;
    padding-top: 2.5rem;
    border-top: 1px solid #e4e4e7;
  }
  .proof h3 {
    font-size: clamp(2rem, 3.4vw, 3rem);
    letter-spacing: -0.045em;
    line-height: 1;
    font-weight: 600;
  }
  .proof li p {
    margin-top: 0.85rem;
    max-width: 22rem;
    color: #52525b;
  }
  .more {
    margin-top: 2.5rem;
    font-weight: 600;
    color: #047857;
  }
  .foot {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 0.5rem 2rem;
    padding-block: 6rem 5rem;
    font-size: 0.8125rem;
    color: #71717a;
  }

  @media (max-width: 52rem) {
    .copy {
      grid-template-columns: minmax(0, 1fr);
      padding-top: 3.5rem;
    }
    .top nav a:nth-child(n + 3) {
      display: none;
    }
    .proof ul {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
