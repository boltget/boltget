---
import { getCollection, render } from "astro:content";
import ReadingPage from "../components/ReadingPage.astro";
import Base from "../layouts/Base.astro";
import { t } from "../i18n";

const [entry] = await getCollection("changelog");
if (!entry) throw new Error("CHANGELOG.md was not found at the repository root");
const { Content, headings } = await render(entry);
---

<Base title={t("changelog.title")} description={t("changelog.description")}>
  <ReadingPage headings={headings} navigationLabel={t("changelog.navigation")}>
    <Content />
  </ReadingPage>
</Base>
