---
// /benchmarks (docs/WEBSITE.md, Benchmarks): one headline, one lede, one
// chart of median times per test (Boltget's adaptive default against the
// other download manager's default), one sentence of result, and the method
// folded away. Reads the newest bench/results/ run at build time
// (src/lib/bench.ts); every number is a value from its summary.csv.
import { getEntry, render } from "astro:content";
import Base from "../layouts/Base.astro";
import { t, tDynamic } from "../i18n";
import { highlight } from "../lib/rich";
import { fixed, latestRun, rowOf, targetsOf, verdict } from "../lib/bench";

const run = latestRun();

const notes = await getEntry("pages", "benchmark-notes");
if (!notes) throw new Error("Missing src/content/pages/benchmark-notes.mdx");
const { Content: Notes } = await render(notes);

const label = (target: string) => {
  try {
    return tDynamic(`bench.targets.${target}`);
  } catch {
    return target;
  }
};

const tests = targetsOf(run).map((target) => {
  const bolt = rowOf(run, target, "boltget", "auto");
  const other = rowOf(run, target, "idm", "default");
  const max = Math.max(bolt.medianS, other.medianS);
  return {
    label: label(target),
    verdict: verdict(run, target),
    bars: [
      { key: "boltget", name: t("bench.series.boltget"), value: bolt.medianS, width: (bolt.medianS / max) * 100 },
      { key: "other", name: t("bench.series.other"), value: other.medianS, width: (other.medianS / max) * 100 },
    ],
  };
});

const total = tests.length;
const count = (v: string) => tests.filter((x) => x.verdict === v).length;
const result = [
  count("faster") > 0 && t("bench.result.faster", { count: count("faster"), total }),
  count("slower") > 0 && t("bench.result.slower", { count: count("slower"), total }),
  count("overlap") > 0 && t("bench.result.overlap"),
]
  .filter(Boolean)
  .join(" ");

const resultsDir = `bench/results/${run.id}`;
---

<Base title={t("bench.title")} description={t("bench.description")}>
  <div class="wrap page">
    <header class="intro">
      <h1>{t("bench.heading")}</h1>
      <p class="lede" set:html={highlight(t("bench.lede"))} />
    </header>

    <figure class="chart" aria-label={t("bench.chartLabel")}>
      <p class="legend" aria-hidden="true">
        <span><i class="swatch boltget"></i>{t("bench.series.boltget")}</span>
        <span><i class="swatch other"></i>{t("bench.series.other")}</span>
      </p>
      <ul class="tests">
        {
          tests.map((test) => (
            <li>
              <p class="test">{test.label}</p>
              {test.bars.map((b) => (
                <div class:list={["row", b.key]}>
                  <span class="visually-hidden">{b.name}:</span>
                  <span class="track">
                    <span class="bar" style={`width: ${b.width.toFixed(2)}%`} />
                  </span>
                  <span class="value">{t("bench.seconds", { value: fixed(b.value, 2) })}</span>
                </div>
              ))}
            </li>
          ))
        }
      </ul>
    </figure>

    <p class="result">{result}</p>

    <details class="method fold">
      <summary>{notes.data.title}</summary>
      <div class="method-body">
        <Notes />
        <p class="links">
          <a href={t("site.repoTree", { path: resultsDir })}>{t("bench.raw")}</a>
          <span aria-hidden="true">·</span>
          <a href={t("site.repoBlob", { path: "docs/BENCHMARK.md" })}>{t("bench.method")}</a>
        </p>
      </div>
    </details>
  </div>
</Base>

<style>
  .page {
    max-width: 52rem;
  }
  .intro {
    display: grid;
    justify-items: center;
    gap: 1.25rem;
    padding-top: clamp(3.5rem, 10vh, 6rem);
    text-align: center;
  }
  h1 {
    font-size: var(--type-display);
    font-weight: 400;
    line-height: 1.04;
    letter-spacing: -0.03em;
    color: var(--ink);
  }
  .intro .lede {
    max-width: 34rem;
  }

  .chart {
    margin: clamp(2.5rem, 6vw, 4rem) 0 0;
    padding: clamp(1.5rem, 4vw, 2.5rem);
    border-radius: 20px;
    background: linear-gradient(180deg, var(--atmosphere-mist), var(--white) 55%);
    box-shadow: var(--hairline-shadow);
  }
  .legend {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.5rem;
    font-size: 0.8125rem;
    color: var(--text-muted);
  }
  .legend span {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
  }
  .swatch {
    width: 0.75rem;
    height: 0.75rem;
    border-radius: 3px;
  }
  .tests {
    display: grid;
    gap: 1.75rem;
    margin: 1.75rem 0 0;
    padding: 0;
    list-style: none;
  }
  .test {
    margin-bottom: 0.5rem;
    font-size: 0.9375rem;
    font-weight: 500;
    color: var(--ink);
  }
  .row {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 4.5rem;
    align-items: center;
    gap: 0.75rem;
  }
  .row + .row {
    margin-top: 0.35rem;
  }
  .track {
    display: block;
    height: 0.875rem;
  }
  .bar {
    display: block;
    height: 100%;
    min-width: 3px;
    border-radius: 0 4px 4px 0;
  }
  /* Boltget in ink, the other download manager in graphite. */
  .boltget .bar,
  .swatch.boltget {
    background: var(--ink);
  }
  .other .bar,
  .swatch.other {
    background: var(--graphite-300);
  }
  .value {
    font-size: 0.8125rem;
    font-variant-numeric: tabular-nums;
    text-align: right;
    color: var(--text-muted);
  }
  .boltget .value {
    color: var(--ink);
    font-weight: 500;
  }

  .result {
    max-width: 36rem;
    margin: 1.5rem auto 0;
    text-align: center;
    font-size: 0.9375rem;
    color: var(--text-muted);
  }

  .method {
    margin-top: clamp(3rem, 7vw, 4.5rem);
    border-top: 1px solid var(--hairline);
    border-bottom: 1px solid var(--hairline);
  }
  summary {
    padding: 1rem 0.25rem;
    font-weight: 500;
    color: var(--ink);
    cursor: pointer;
  }
  .method-body {
    display: grid;
    gap: 0.9rem;
    max-width: 40rem;
    padding: 0 0.25rem 1.5rem;
    font-size: 0.9375rem;
    color: var(--text-muted);
  }
  .method-body :global(code) {
    font-size: 0.85em;
    color: var(--ink);
  }
  .method-body a {
    color: var(--ink);
    text-decoration-color: rgb(10 10 11 / 0.25);
    text-underline-offset: 0.3em;
  }
  .method-body a:hover {
    text-decoration-color: currentColor;
  }
  .links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 0.75rem;
    color: var(--text-subtle);
  }
</style>
