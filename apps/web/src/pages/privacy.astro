---
import { getEntry, render } from "astro:content";
import ReadingPage from "../components/ReadingPage.astro";
import Base from "../layouts/Base.astro";

import { t } from "../i18n";

const entry = await getEntry("pages", "privacy");
if (!entry) throw new Error("Missing src/content/pages/privacy.mdx");
const { Content, headings } = await render(entry);
---

<Base title={entry.data.title} description={entry.data.description}>
  <ReadingPage headings={headings} navigationLabel={t("privacy.navigation")}>
    <h1>{entry.data.title}</h1>
    <Content />
  </ReadingPage>
</Base>
