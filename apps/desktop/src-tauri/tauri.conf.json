{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Boltget",
  "identifier": "app.boltget.desktop",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "Boltget",
        "width": 1280,
        "height": 800,
        "minWidth": 640,
        "minHeight": 440,
        "center": true,
        "visible": false,
        "decorations": false,
        "shadow": true,
        "resizable": true,
        "zoomHotkeysEnabled": false,
        "scrollBarStyle": "fluentOverlay"
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self'",
        "script-src": "'self'",
        "style-src": "'self' 'unsafe-inline'",
        "img-src": "'self' data:",
        "font-src": "'self'",
        "connect-src": "ipc: http://ipc.localhost"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "../../../brand/png/icon-32.png",
      "../../../brand/png/icon-128.png",
      "../../../brand/png/icon-256.png",
      "../../../brand/ico/app.ico"
    ]
  }
}
